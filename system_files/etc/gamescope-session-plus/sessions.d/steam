eval "$(/usr/libexec/armada/device-env)"

[[ -n "${ARMADA_PRIMARY_CONNECTOR:-}" ]] && OUTPUT_CONNECTOR="$ARMADA_PRIMARY_CONNECTOR"
[[ -n "${ARMADA_PANEL_TYPE:-}" ]] && PANEL_TYPE="$ARMADA_PANEL_TYPE"
[[ -n "${ARMADA_PANEL_ORIENTATION:-}" ]] && ORIENTATION="$ARMADA_PANEL_ORIENTATION"
[[ -n "${ARMADA_PANEL_NATIVE_WIDTH:-}" ]] && SCREEN_WIDTH="$ARMADA_PANEL_NATIVE_WIDTH"
[[ -n "${ARMADA_PANEL_NATIVE_HEIGHT:-}" ]] && SCREEN_HEIGHT="$ARMADA_PANEL_NATIVE_HEIGHT"
if [[ -n "${ARMADA_PANEL_REFRESH_RATES:-}" ]]; then
    CUSTOM_REFRESH_RATES="$ARMADA_PANEL_REFRESH_RATES"
    IFS=',' read -r -a ARMADA_REFRESH_RATE_LIST <<< "$ARMADA_PANEL_REFRESH_RATES"
    if (( ${#ARMADA_REFRESH_RATE_LIST[@]} > 1 )); then
        STEAM_DISPLAY_REFRESH_LIMITS="${ARMADA_REFRESH_RATE_LIST[0]},${ARMADA_REFRESH_RATE_LIST[-1]}"
    else
        unset STEAM_DISPLAY_REFRESH_LIMITS
    fi
fi
USE_ROTATION_SHADER="${ARMADA_GAMESCOPE_USE_ROTATION_SHADER:-0}"
# Gamescope only lights up the primary panel; silence the secondary
# touchscreen so fingers on the dark glass don't move Steam's cursor.
# The desktop session re-enables it (see desktop-bootstrap).
if [[ -n "${ARMADA_SECONDARY_TOUCHSCREEN:-}" ]]; then
    /usr/libexec/armada/touchscreen-inhibit "$ARMADA_SECONDARY_TOUCHSCREEN" 1 2>/dev/null || true
fi
if [[ -n "${ARMADA_GAMESCOPE_FAKE_OUTPUT_MM:-}" ]]; then
    export GAMESCOPE_FAKE_OUTPUT_MM="$ARMADA_GAMESCOPE_FAKE_OUTPUT_MM"
fi

# Decky's Display menu writes this (armada-control's set_display_config
# action) when the player picks an external screen as primary. Only trusted
# if that connector is ACTUALLY connected right now: gamescope's own output
# choice is a startup-time flag (no live hotplug re-pick), so a stale choice
# from a monitor that's since been unplugged must fall back to the internal
# panel defaults already set above, not strand the session on a dead output.
ARMADA_DISPLAY_OVERRIDE=/etc/armada/display-override.conf
# Records which external connector this session actually launched on (not
# merely which one is configured) - armada-display-hotplug restarts the
# session back onto the internal panel only when THIS connector unplugs,
# and the absence of the marker after that restart is what stops it from
# restarting again in a loop.
ARMADA_DISPLAY_MARKER="${XDG_RUNTIME_DIR:-/run/user/1000}/armada-display-connector"
rm -f "$ARMADA_DISPLAY_MARKER"
if [[ -f "$ARMADA_DISPLAY_OVERRIDE" ]]; then
    # shellcheck source=/dev/null
    source "$ARMADA_DISPLAY_OVERRIDE"
    if [[ -n "${ARMADA_DISPLAY_CONNECTOR:-}" ]]; then
        display_connected=0
        for status_file in /sys/class/drm/card*-"${ARMADA_DISPLAY_CONNECTOR}"/status; do
            [[ -f "$status_file" ]] || continue
            [[ "$(cat "$status_file" 2>/dev/null)" == "connected" ]] && display_connected=1
        done
        # A portrait (width < height) choice can only come from a stale/
        # hand-edited override - the Decky UI itself refuses to save one,
        # since gamescope can't rotate an external output to compensate
        # (confirmed live on the official Retroid Screen Add-on: its only
        # EDID mode is 1080x1920). Trusting it here would silently strand
        # game mode sideways with no way to fix it except SSH, so it's
        # treated the same as "not connected" - fall back to internal.
        if (( display_connected )) \
            && [[ -n "${ARMADA_DISPLAY_WIDTH:-}" && -n "${ARMADA_DISPLAY_HEIGHT:-}" ]] \
            && (( ARMADA_DISPLAY_WIDTH < ARMADA_DISPLAY_HEIGHT )); then
            display_connected=0
        fi
        if (( display_connected )); then
            printf '%s\n' "$ARMADA_DISPLAY_CONNECTOR" > "$ARMADA_DISPLAY_MARKER"
            # Listed first as a preference, not the only option: if the same
            # connector somehow vanishes between this check and gamescope's
            # own probe a moment later, it still falls back to the internal
            # panel instead of failing to start.
            OUTPUT_CONNECTOR="${ARMADA_DISPLAY_CONNECTOR},${OUTPUT_CONNECTOR}"
            [[ -n "${ARMADA_DISPLAY_WIDTH:-}" ]] && SCREEN_WIDTH="$ARMADA_DISPLAY_WIDTH"
            [[ -n "${ARMADA_DISPLAY_HEIGHT:-}" ]] && SCREEN_HEIGHT="$ARMADA_DISPLAY_HEIGHT"
            # NOT settable per-output: confirmed live (not just from
            # gamescope's own --help, which says --force-orientation
            # "rotate[s] the internal display") - made an external output
            # the genuinely active one (internal disabled) and the flag
            # still had zero visible effect on it in either direction. It
            # only ever affects the internal panel regardless of what
            # gamescope is actually driving, so force it (and the shader
            # variant of the same thing) back to the internal panel's own
            # unrotated state whenever an external display is primary -
            # CUSTOM_REFRESH_RATES is still internal-panel-specific and
            # dropped for the same reason as before.
            ORIENTATION=normal
            USE_ROTATION_SHADER=0
            unset CUSTOM_REFRESH_RATES STEAM_DISPLAY_REFRESH_LIMITS
        fi
    fi
fi

# The 1024-sample PipeWire quantum SM8250 needs is set by armada-device-quirks
# (system-level, before pipewire/wireplumber ever start - there's no pw-metadata
# binary on this image to poke it at session time, and it wouldn't need to be
# session-scoped anyway).
if [[ "${ARMADA_SOC_CLASS:-}" == "SM8250" ]]; then
    # Steam's own auto-scale heuristic badly overestimates the UI scale for
    # this device's small high-DPI panel; see armada-fix-steam-scale for why.
    # No-ops once the user has picked their own value via Steam's slider.
    /usr/libexec/armada/armada-fix-steam-scale || true
fi

export STEAM_EXTRA_COMPAT_TOOLS_PATHS="/usr/share/steam/compatibilitytools.d:${HOME}/.local/share/Steam/compatibilitytools.d"

CLIENTCMD='/usr/libexec/armada/launch-steam -gamepadui -steamos3 -steampal -steamdeck -noverifyfiles -noshaders'

# gamescope-session-plus (/usr/share/gamescope-session-plus/gamescope-session-plus)
# has no passthrough for the extra flags we need (e.g. --mangoapp). The only
# escape hatch is setting GAMESCOPECMD ourselves, which skips its ENTIRE auto-
# build block. So this reproduces that block's exact logic (same defaults, same
# gamescope_has_option() feature-detection calls, same variables it already
# reads from us) rather than hand-picking just what we currently use, so it
# doesn't silently stop tracking upstream's own flag set if we start using
# more of these variables later. Diff against gamescope-session-plus's own
# script before touching this if gamescope-session-plus itself gets updated.
#
# Note: --force-composition used to be forced here so ambilight's old kmsgrab
# capture would keep seeing output even during fullscreen games. Ambilight now
# uses gamescopectl screenshot (composited output), so direct scanout is left
# enabled - matching upstream behavior and avoiding compositor artifacts on
# some panels (e.g. a horizontal line on Retroid Pocket 6).
: "${OUTPUT_CONNECTOR:=*,eDP-1}"
: "${XWAYLAND_COUNT:=2}"
: "${TOUCH_MODE:=4}"
: "${HIDE_CURSOR_DELAY_MS:=3000}"
: "${FADE_OUT_DURATION_MS:=200}"

CURSOR=""
[[ -f "${CURSOR_FILE:-}" ]] && CURSOR="--cursor ${CURSOR_FILE}"

RESOLUTION=""
[[ -n "${SCREEN_WIDTH:-}" && -n "${SCREEN_HEIGHT:-}" ]] && RESOLUTION="-W $SCREEN_WIDTH -H $SCREEN_HEIGHT"

INTERNAL_RESOLUTION=""
[[ -n "${INTERNAL_WIDTH:-}" && -n "${INTERNAL_HEIGHT:-}" ]] && INTERNAL_RESOLUTION="-w $INTERNAL_WIDTH -h $INTERNAL_HEIGHT"

DRM_MODE_OPTION=""
[[ -n "${DRM_MODE:-}" ]] && DRM_MODE_OPTION="--generate-drm-mode $DRM_MODE"

ORIENTATION_OPTION=""
[[ -n "${ORIENTATION:-}" ]] && ORIENTATION_OPTION="--force-orientation $ORIENTATION"

ADAPTIVE_SYNC_OPTION=""
[[ -n "${ADAPTIVE_SYNC:-}" ]] && ADAPTIVE_SYNC_OPTION="--adaptive-sync"

PANEL_TYPE_OPTION=""
[[ -n "${PANEL_TYPE:-}" ]] && gamescope_has_option "--force-panel-type" && PANEL_TYPE_OPTION="--force-panel-type $PANEL_TYPE"

CUSTOM_REFRESH_RATES_OPTION=""
[[ -n "${CUSTOM_REFRESH_RATES:-}" ]] && gamescope_has_option "--custom-refresh-rates" && CUSTOM_REFRESH_RATES_OPTION="--custom-refresh-rates $CUSTOM_REFRESH_RATES"

USE_ROTATION_SHADER_OPTION=""
[[ "${USE_ROTATION_SHADER:-0}" != 0 ]] && gamescope_has_option "--use-rotation-shader" && USE_ROTATION_SHADER_OPTION="--use-rotation-shader"

BACKEND_OPTION=""
[[ -n "${BACKEND:-}" ]] && gamescope_has_option "--backend" && BACKEND_OPTION="--backend $BACKEND"

MAX_SCALE_OPTION=""
[[ -n "${MAX_SCALE:-}" ]] && gamescope_has_option "--max-scale" && MAX_SCALE_OPTION="--max-scale $MAX_SCALE"

HDR_OPTIONS=""
if [[ "${ENABLE_GAMESCOPE_HDR:-}" == "1" && "${ENABLE_GAMESCOPE_WSI:-}" == "1" ]] && gamescope_has_option "--hdr-enabled" && gamescope_has_option "--hdr-itm-enable"; then
    HDR_OPTIONS="--hdr-enabled --hdr-itm-enable"
    export ENABLE_HDR_WSI=1
    export DXVK_HDR=1
    export GAMESCOPE_WAYLAND_DISPLAY="gamescope-0"
fi
if [[ -n "${GAMESCOPE_HDR_NITS:-}" ]] && gamescope_has_option "--hdr-itm-sdr-nits" && gamescope_has_option "--hdr-sdr-content-nits"; then
    HDR_OPTIONS="$HDR_OPTIONS --hdr-itm-sdr-nits $GAMESCOPE_HDR_NITS --hdr-sdr-content-nits $GAMESCOPE_HDR_NITS"
fi

# Decky's "Performance Overlay" toggle (Compatibility tab) writes this into
# the same game-tweaks.json armada-game-launch already reads per-game -
# global.mangoapp is the one field read here, at session-launch time, since
# gamescope's own overlay is a whole-session flag, not a per-game one.
MANGOAPP_OPTION=""
if [[ -f /etc/armada/game-tweaks.json ]] \
    && [[ "$(jq -r '.global.mangoapp // false' /etc/armada/game-tweaks.json 2>/dev/null)" == "true" ]] \
    && gamescope_has_option "--mangoapp"; then
    MANGOAPP_OPTION="--mangoapp"
fi

GAMESCOPECMD="$(get_gamescope_binary) \
    $CURSOR \
    $RESOLUTION \
    $INTERNAL_RESOLUTION \
    $ORIENTATION_OPTION \
    $DRM_MODE_OPTION \
    $ADAPTIVE_SYNC_OPTION \
    $PANEL_TYPE_OPTION \
    $CUSTOM_REFRESH_RATES_OPTION \
    $USE_ROTATION_SHADER_OPTION \
    $BACKEND_OPTION \
    $HDR_OPTIONS \
    $MAX_SCALE_OPTION \
    $MANGOAPP_OPTION \
    --prefer-output $OUTPUT_CONNECTOR \
    --xwayland-count $XWAYLAND_COUNT \
    --default-touch-mode $TOUCH_MODE \
    --hide-cursor-delay $HIDE_CURSOR_DELAY_MS \
    --fade-out-duration $FADE_OUT_DURATION_MS \
    --steam"
