#!/bin/bash
set -euo pipefail

user_name=armada
homebrew="/var/home/${user_name}/homebrew"
loader_src=/usr/share/decky-loader/PluginLoader
loader_version_src=/usr/share/decky-loader/.loader.version
src=/usr/share/decky-plugins

loader_needs_seed() {
    [[ ! -x "${homebrew}/services/PluginLoader" ]] && return 0
    [[ -f "${loader_version_src}" ]] || return 1
    [[ -f "${homebrew}/services/.loader.version" ]] || return 0

    local bundled current newest
    bundled=$(<"${loader_version_src}")
    current=$(<"${homebrew}/services/.loader.version")
    newest=$(printf '%s\n%s\n' "${current}" "${bundled}" | sort -V | tail -n1)
    [[ "${newest}" == "${bundled}" && "${bundled}" != "${current}" ]]
}

install -d -m 0755 "${homebrew}/services"
install -d -m 0755 "${homebrew}/plugins"
install -d -m 0755 "${homebrew}/settings"

# One-time migration for installs that picked up plugin_loader.service back
# when it was installed straight into /etc/systemd/system (see git history:
# "Revert back to using standard decky loader service"). A unit *file* in
# /etc goes through ostree's per-boot 3-way /etc merge like any other /etc
# content, unlike the rest of this codebase's units (defined under
# /usr/lib/systemd/system, only their enable-state symlink lives in /etc) -
# confirmed to leave Decky permanently gone after an OTA in practice. Once
# it moved to /usr/lib/systemd/system, the leftover /etc copy shadows it
# (systemd prefers /etc/systemd/system over /usr/lib/systemd/system for a
# same-named unit), so it has to be removed, not just left alongside.
stale_etc_unit=/etc/systemd/system/plugin_loader.service
if [[ -f "${stale_etc_unit}" && ! -L "${stale_etc_unit}" ]]; then
    was_active=0
    systemctl is-active --quiet plugin_loader.service && was_active=1
    rm -f "${stale_etc_unit}"
    rm -f /etc/systemd/system/multi-user.target.wants/plugin_loader.service
    systemctl daemon-reload
    systemctl enable plugin_loader.service >/dev/null 2>&1 || true
    [[ "${was_active}" = 1 ]] && systemctl start plugin_loader.service >/dev/null 2>&1 || true
fi

# Decky owns self-updates; the image copy seeds installs and newer OS-bundled loaders.
if loader_needs_seed && [[ -x "${loader_src}" ]]; then
    install -Dpm 0755 "${loader_src}" "${homebrew}/services/PluginLoader"
    [[ ! -f "${loader_version_src}" ]] || install -Dpm 0644 "${loader_version_src}" "${homebrew}/services/.loader.version"
fi

if [[ -x "${homebrew}/services/PluginLoader" ]]; then
    chcon -t bin_t "${homebrew}/services/PluginLoader" >/dev/null 2>&1 || true
fi

if [[ ! -f "${homebrew}/settings/loader.json" ]]; then
    # Default new installs to Decky's prerelease channel for current Steam-on-ARM fixes.
    printf '{\n  "branch": 1\n}\n' >"${homebrew}/settings/loader.json"
fi

if [[ -d "$src" ]]; then
    for plugin in "$src"/*/; do
        [[ -d "$plugin" ]] || continue
        name=$(basename "$plugin")
        rm -rf "${homebrew}/plugins/${name}"
        cp -a "$plugin" "${homebrew}/plugins/${name}"
    done
fi

chown "${user_name}:${user_name}" "${homebrew}"
chown -R "${user_name}:${user_name}" "${homebrew}/services"
chown -R "${user_name}:${user_name}" "${homebrew}/plugins"
[[ ! -d "${homebrew}/settings" ]] || chown -R "${user_name}:${user_name}" "${homebrew}/settings"
