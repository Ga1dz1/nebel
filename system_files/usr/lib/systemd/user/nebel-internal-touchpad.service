[Unit]
Description=Nebel internal touchscreen pass-through (game mode on an external display)
# Started by sessions.d/steam whenever an external display owns game mode
# (the touchpad toggle only picks the daemon's output mode, the service
# always runs); restarted live by nebel-control's toggle; stopped by
# desktop-bootstrap and by the next internal-primary session.
# No [Install] on purpose - never enabled, explicit start/stop only.

[Service]
ExecStart=/usr/libexec/nebel/internal-touchpad
Restart=on-failure
RestartSec=1
