[Unit]
Description=Apply Nebel Input Calibration
DefaultDependencies=no
After=systemd-modules-load.service
Before=inputplumber.service
ConditionPathExists=/etc/nebel/input-calibration.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/nebel/apply-input-calibration

[Install]
WantedBy=multi-user.target
