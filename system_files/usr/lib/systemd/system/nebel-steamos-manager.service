[Unit]
Description=nebel SteamOS Manager compatibility service
After=nebel-powerd.service
Requires=nebel-powerd.service

[Service]
Type=dbus
BusName=com.steampowered.SteamOSManager1
ExecStart=/usr/libexec/nebel/steamos-manager --system
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
