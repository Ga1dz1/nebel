[Unit]
Description=nebel power policy daemon
StartLimitIntervalSec=0
# Apply profile/IRQ affinity before the session starts so the greeter and
# gamescope never run on the wrong CPU set or power profile.
Before=display-manager.service

[Service]
Type=dbus
BusName=org.nebel.Power
NotifyAccess=main
ExecStart=/usr/libexec/nebel/nebel-powerd
ExecStopPost=/usr/libexec/nebel/nebel-powerd --fan-safe
Restart=always
RestartSec=1
WatchdogSec=15

[Install]
WantedBy=multi-user.target
