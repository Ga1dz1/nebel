[Unit]
Description=nebel: create the Steam library as a btrfs nodatacow subvolume
After=local-fs.target
RequiresMountsFor=/var/home/nebel
Before=sddm.service
ConditionPathExists=!/var/home/nebel/.local/share/Steam/steamapps

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/nebel/setup-steamapps

[Install]
WantedBy=multi-user.target
