[Unit]
Description=Auto-calibrate handheld gamepad stick centers at boot
# Always runs, even when /etc/nebel/input-calibration.json exists: the static
# config carries ranges/deadzones (applied by nebel-input-calibration), while
# centers drift boot-to-boot and are re-measured here every time.
DefaultDependencies=no
After=systemd-modules-load.service systemd-udev-trigger.service
Before=inputplumber.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/nebel/gamepad-autocalibrate
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
