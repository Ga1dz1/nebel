[Unit]
Description=Auto-calibrate handheld gamepad stick centers at boot
DefaultDependencies=no
After=systemd-modules-load.service systemd-udev-trigger.service
Before=inputplumber.service
ConditionPathExists=!/etc/nebel/input-calibration.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/nebel/gamepad-autocalibrate
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
