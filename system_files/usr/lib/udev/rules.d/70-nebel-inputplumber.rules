# Steam needs group access to the deck-uhid hidraw node. InputPlumber
# emulates a real Steam Deck (28DE:1205) since patch 0006; 28DE:12F0 is the
# old generic PID kept for downgrade compatibility.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0003:28DE:1205.*", GROUP="input", MODE="0660"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0003:28DE:12F0.*", GROUP="input", MODE="0660"

# InputPlumber shares the raw AYN gamepad with Waydroid. Keep desktop input
# consumers on the virtual deck-uhid device instead of the raw event node.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="2020", ATTRS{id/product}=="3001", ATTRS{phys}=="rsinput-gamepad/input0", ENV{NEBEL_WAYDROID_GAMEPAD}="1", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT_MOUSE}="", ENV{ID_INPUT_JOYSTICK}="", TAG-="uaccess", MODE="0000"
SUBSYSTEM=="input", KERNEL=="js*", ATTRS{id/vendor}=="2020", ATTRS{id/product}=="3001", ATTRS{phys}=="rsinput-gamepad/input0", ENV{ID_INPUT_JOYSTICK}="", TAG-="uaccess", MODE="0000"
