# No ID_INPUT_JOYSTICK tag: InputPlumber's composite_device.yaml matches this
# device by phys_path/handler (not by udev class), and its own driver-type
# detection already defaults to the gamepad implementation for untagged
# devices (see get_driver_type() in InputPlumber's src/input/source/evdev.rs)
# - so the tag isn't needed for InputPlumber to work. What it WAS doing is
# making Steam/SDL's udev-based joystick enumeration see this raw node as a
# second, ghost controller once "passthrough: true" (in
# 01-retroid-controller.yaml, needed for the reactive LED mode) leaves it
# ungrabbed/visible. Leaving the class untagged keeps Steam from picking it
# up at all, while InputPlumber and nebel-stick-led's reactive reader both
# keep working off phys_path/MODE=0666 alone.
SUBSYSTEM=="input", ATTRS{name}=="Retroid Pocket Gamepad", MODE="0666"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT}=="1", ATTRS{name}=="pmi8998_haptics", TAG+="uaccess", ENV{FEEDBACKD_TYPE}="vibra"

# Marks the raw event node so waydroid-input-setup can find it and expose it
# to Waydroid, same mechanism as the AYN family's own rule in
# 70-nebel-inputplumber.rules. MODE/uaccess for this device are already
# handled by the line above - passthrough (01-retroid-controller.yaml)
# already leaves it visible, this just tags which node it is.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Retroid Pocket Gamepad", ENV{NEBEL_WAYDROID_GAMEPAD}="1"

# The MCU reports Back as BTN_BACK (0x116), which sits in the BTN_MOUSE
# range, so stock udev tags the pad ID_INPUT_MOUSE=1 and libinput picks it up
# as an ABSOLUTE POINTER (sticks on ABS_X/ABS_Y) - moving a stick then drags
# a phantom cursor over every libinput session (labwc dual-screen, Plasma).
# Same treatment as the AYN rule above: hide the raw node from libinput only.
# InputPlumber, SDL/Steam and the session watchers all read evdev directly
# and are unaffected.
# The MCU reports Back as BTN_BACK (0x116), which sits in the BTN_MOUSE
# range, so stock udev tags the pad ID_INPUT_MOUSE=1 and libinput picks it up
# as an ABSOLUTE POINTER (sticks on ABS_X/ABS_Y) - moving a stick then drags
# a phantom cursor over every libinput session (labwc dual-screen, Plasma).
# On top of that, Steam's bundled SDL3 and flatpak SDL builds enumerate
# joysticks by scanning /dev/input/event* capabilities directly (no udev tag
# check), so the raw pad showed up as a second, conflicting controller
# (double input in Steam UI). Same treatment as the AYN rule in
# 70-nebel-inputplumber.rules: hide the raw node from libinput AND from
# unprivileged processes entirely. Every legitimate consumer runs as root
# (InputPlumber, nebel-stick-led, nebel-desktop-hotkeys, waydroid) or through
# sudo (nebel-dualscreen-exit, see etc/sudoers.d/nebel-session-control).
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Retroid Pocket Gamepad", ENV{LIBINPUT_IGNORE_DEVICE}="1", ENV{ID_INPUT_MOUSE}="", ENV{ID_INPUT_JOYSTICK}="", TAG-="uaccess", MODE="0000"

# The js* node has no capability filtering at all: SDL's non-udev fallback
# (Steam runtime, flatpak apps without a udev db) scans /dev/input/js*
# directly and would find the raw pad as a ghost controller beside
# InputPlumber's virtual one. Nothing on the system consumes the legacy js
# interface for this pad (InputPlumber, watchers, LED reader, Waydroid all
# use the event node) - lock it away like the AYN rule does.
SUBSYSTEM=="input", KERNEL=="js*", ATTRS{name}=="Retroid Pocket Gamepad", ENV{ID_INPUT_JOYSTICK}="", ENV{ID_INPUT_MOUSE}="", TAG-="uaccess", MODE="0000"
