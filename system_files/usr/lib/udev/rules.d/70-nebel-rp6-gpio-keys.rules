# Retroid Pocket 6 gpio-keys (VolUp + back paddles as BTN_C/BTN_Z): the
# BTN_* codes make udev classify the node as a joystick, which would show
# up as a stray "gpio keys" controller in gamescope/Steam. InputPlumber
# grabs this node directly as a second source of the AYN composite
# (02-ayn-controller.yaml) and folds the paddles into the Deck pad as
# L4/R4, re-emitting VolUp on the keyboard target - so hide the node from
# libinput/SDL entirely.
#
# Other Retroid devices (RP5/Flip/Mini) route plain volume keys through a
# node with the SAME name and phys, so name+phys alone is not enough -
# gate on the devicetree model so only RP6 variants are touched.

SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="gpio-keys", ATTRS{phys}=="gpio-keys/input0", PROGRAM=="/bin/sh -c 'grep -q \"Retroid Pocket 6\" /sys/firmware/devicetree/base/model'", ENV{ID_INPUT_JOYSTICK}="", ENV{ID_INPUT_KEY}="1", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="uaccess", TAG-="seat", MODE="0000"
