# Retroid Pocket 6 gpio-keys (VolUp + back paddles as BTN_C/BTN_Z): the
# BTN_* codes make udev classify the node as a joystick, which libinput
# refuses to initialize - so KEY_VOLUMEUP never reached gamescope/Steam.
# The node is owned by the nebel-gpio-keys splitter daemon (VolUp passthrough
# on a virtual keyboard + paddles re-emitted as BTN_C/BTN_Z on a virtual
# gamepad node for InputPlumber), so hide it from libinput/SDL entirely.
# The daemon re-emits everything; the virtual devices are what
# gamescope/Steam see.
#
# Other Retroid devices (RP5/Flip/Mini) route plain volume keys through a
# node with the SAME name and phys, so name+phys alone is not enough - the
# rule previously killed VolUp on the Mini. Only the RP6 node carries
# BTN_C/BTN_Z, so gate on that via the daemon's --check helper (same
# capability test the daemon uses before grabbing).

SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="gpio-keys", ATTRS{phys}=="gpio-keys/input0", PROGRAM=="/usr/libexec/nebel/nebel-gpio-keys --check /sys%E{DEVPATH}", ENV{ID_INPUT_JOYSTICK}="", ENV{ID_INPUT_KEY}="1", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="uaccess", TAG-="seat", MODE="0000"

# The daemon's virtual paddles node ("Nebel RP6 Paddles", 222A:0004) is only
# a transport for InputPlumber, which folds BTN_C/BTN_Z into the Deck
# composite as L4/R4 (02-ayn-controller.yaml matches it by vid/pid, and
# InputPlumber runs as root, so the stripped tags/permissions do not affect
# it). It must NOT appear as a standalone second gamepad in gamescope/Steam.
# Match on the NAME: internal-touchpad's whole-panel pointer ("Nebel
# Touchpad") reuses the same 222A:0004 ids on purpose, and hiding that node
# kills the trackpad mode on RP5/Mini.

SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Nebel RP6 Paddles", ATTRS{id/vendor}=="222a", ATTRS{id/product}=="0004", ENV{ID_INPUT_JOYSTICK}="", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG-="uaccess", TAG-="seat", MODE="0000"
