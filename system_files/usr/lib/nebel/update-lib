#!/bin/bash
# Shared helpers for the nebel update hooks (steamos-update, steamos-select-branch).

NEBEL_REGISTRY="ghcr.io/ga1dz1/nebel"
NEBEL_CHANNEL_STATE="/var/lib/nebel/update-channel"
NEBEL_CHANNELS="stable beta testing"

# Steam's picker speaks Valve's branch tokens; translate to/from our ghcr tags.
nebel_token_to_channel() {
    case "$1" in
        rel|latest|stable) echo stable ;;
        beta)               echo beta ;;
        rc|bc|main|preview|testing) echo testing ;;
        *) return 1 ;;
    esac
}
nebel_channel_to_token() {
    case "$1" in
        beta)    echo beta ;;
        testing) echo preview ;;
        *)       echo rel ;;
    esac
}

# Tag from a container ref, stripping any @digest and transport/registry prefix.
nebel_tag_from_ref() {
    local r="${1%@*}"; r="${r##*/}"
    [[ "$r" == *:* ]] && echo "${r##*:}" || echo ""
}

# Raw container-image-reference of the booted deployment. rpm-ostree works
# unprivileged (bootc status needs root), so the -c query can call this.
nebel_booted_ref() {
    rpm-ostree status --booted --json 2>/dev/null | python3 -c \
        'import sys,json; d=json.load(sys.stdin).get("deployments") or [{}]; print(d[0].get("container-image-reference",""))' 2>/dev/null || true
}
nebel_booted_channel() { nebel_tag_from_ref "$(nebel_booted_ref)"; }

# Raw image ref of the staged (next-boot) deployment, if any. Needs root.
nebel_staged_ref() {
    bootc status --format json 2>/dev/null | python3 -c \
        'import sys,json; st=json.load(sys.stdin).get("status",{}).get("staged"); print(st["image"]["image"]["image"] if st else "")' 2>/dev/null || true
}

# "<booted-digest> <staged-digest> <staged-ref> <staged-version>", "-" keeps
# empty fields positional. Needs root.
nebel_local_state() {
    bootc status --format json 2>/dev/null | python3 -c '
import sys, json
st = json.load(sys.stdin).get("status") or {}
b = (st.get("booted") or {}).get("image") or {}
s = (st.get("staged") or {}).get("image") or {}
out = [b.get("imageDigest"), s.get("imageDigest"), (s.get("image") or {}).get("image"), s.get("version")]
print(" ".join(v or "-" for v in out))
' 2>/dev/null || true
}

# "<digest> <version-label>" of a channel's published image in the registry.
nebel_remote_info() {
    skopeo inspect --format '{{.Digest}} {{index .Labels "org.opencontainers.image.version"}}' \
        "docker://${NEBEL_REGISTRY}:$1" 2>/dev/null || true
}

# Channel version for Steam duplicate detection: digest keeps the fallback
# per-build; channel name only when the probe fails outright.
nebel_remote_version() {
    local d v
    read -r d v <<<"$(nebel_remote_info "$1")" || true
    printf '%s\n' "${v:-${d:-$1}}"
}

# Channel the user selected, validated to a known channel; else $1 (a caller-
# supplied booted channel, to avoid re-querying) or the booted channel.
nebel_desired_channel() {
    local c="" ch b
    [[ -r "$NEBEL_CHANNEL_STATE" ]] && read -r c < "$NEBEL_CHANNEL_STATE" 2>/dev/null
    # A channel picked before the armada->nebel rename lives at the old path.
    [[ -z "$c" && -r /var/lib/armada/update-channel ]] && read -r c < /var/lib/armada/update-channel 2>/dev/null
    # Exact-match a known channel (a substring/glob test would accept a corrupt
    # multi-word value and feed it to bootc as a tag).
    for ch in ${NEBEL_CHANNELS}; do
        [[ "$c" == "$ch" ]] && { echo "$c"; return; }
    done
    b="${1:-$(nebel_booted_channel)}"
    for ch in ${NEBEL_CHANNELS}; do
        [[ "$b" == "$ch" ]] && { echo "$b"; return; }
    done
    # A locally-built/flashed image's tag ("latest", or empty) names no
    # channel; parroting it back made nebel-update try `bootc switch` to a
    # tag that doesn't exist on the registry, fail, and give up - so devices
    # flashed from a release SD image never adopted the OTA channel at all.
    # Default them to testing: the first Steam update check switches to the
    # signed ghcr ref and every later update is a plain upgrade.
    echo testing
}

# Run a bootc command with progress wired to the Steam N% translator. fd 3 must
# be a pipe; use a 0700 tmpdir so the FIFO can't be pre-created by another user.
nebel_bootc_with_progress() {
    local dir rc reader
    dir="$(mktemp -d 2>/dev/null)" || { "$@" 1>&2; return $?; }
    mkfifo "$dir/p" 2>/dev/null || { rm -rf "$dir"; "$@" 1>&2; return $?; }
    /usr/libexec/nebel/update-progress < "$dir/p" &
    reader=$!
    # bootc's own stdout -> stderr; only the translator's N% reaches Steam.
    "$@" --progress-fd 3 3>"$dir/p" 1>&2; rc=$?
    wait "$reader" 2>/dev/null
    rm -rf "$dir"
    return "$rc"
}
