#!/usr/bin/bash
set -euo pipefail

export DESKTOP_SESSION=plasma
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export XDG_SESSION_TYPE=wayland
export KDE_SESSION_VERSION=6

# Ensure the KDE XDG desktop portal backend is available before Plasma/Steam
# asks for a file chooser. In some boot paths the systemd user session does not
# auto-activate plasma-xdg-desktop-portal-kde.service in time.
if ! pgrep -x xdg-desktop-portal-kde >/dev/null 2>&1; then
    systemctl --user start plasma-xdg-desktop-portal-kde.service 2>/dev/null || \
        /usr/libexec/xdg-desktop-portal-kde &
fi

# In Plasma desktop mode the gamepad should act as a mouse/keyboard so the
# handheld can be navigated without a paired controller. Switch InputPlumber to
# the desktop profile while Plasma is running and restore the gamepad profile on
# exit.
DESKTOP_PROFILE="/usr/share/inputplumber/profiles/mouse_keyboard.yaml"
GAMEPAD_PROFILE="/usr/share/inputplumber/profiles/default.yaml"
IPLUMBER_DEVICE="/org/shadowblip/InputPlumber/CompositeDevice0"
IPLUMBER_IFACE="org.shadowblip.Input.CompositeDevice"

armada_inputplumber_profile() {
    local profile="$1"
    busctl --system call org.shadowblip.InputPlumber "${IPLUMBER_DEVICE}" "${IPLUMBER_IFACE}" LoadProfilePath s "${profile}" >/dev/null 2>&1 || true
}

cleanup_plasma() {
    armada_inputplumber_profile "${GAMEPAD_PROFILE}"
}
trap cleanup_plasma EXIT

armada_inputplumber_profile "${DESKTOP_PROFILE}"

/usr/bin/startplasma-wayland
