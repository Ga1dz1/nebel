#!/bin/bash
# Media keys for the dual-screen session: the labwc session has no desktop
# shell and no Steam, so nothing answers the volume buttons and the power
# key (logind is set to ignore it for powerbuttond's sake in Steam sessions).
# Short power press sleeps (suspend-dispatch routes to real/fake per device);
# volume buttons drive the default PipeWire sink. Long power press is ignored.
set -uo pipefail
log() { logger -t nebel-dualscreen-keys -- "$*"; }

# start-dualscreen may relaunch us; only one daemon may hold the keys or
# every press gets answered N times.
exec 9>/run/user/"$(id -u)"/nebel-dualscreen-keys.lock
flock -n 9 || { log "already running, exiting"; exit 0; }

# Volume keys are split across PMIC inputs on retroid devices: Vol+ sits on
# gpio-keys, Vol- on pm8941_resin (the second PMIC button channel). Watch
# every physical device that can carry a volume key; the virtual InputPlumber
# keyboard also advertises them, but it's an aggregate echo - skip "Input"
# devices.
volume_watch() {
    local dev="$1" name
    name="$(cat "/sys/class/input/$(basename "$dev")/device/name" 2>/dev/null)" || return 0
    case "$name" in *InputPlumber*) return 0 ;; esac
    ( evtest "$dev" 2>/dev/null | while read -r l; do
        case "$l" in
            *"(KEY_VOLUMEUP), value 1"*)    out="$(wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ 2>&1)" \
                                            && log "volume up -> $out" || log "volume up FAILED: $out" ;;
            *"(KEY_VOLUMEDOWN), value 1"*)  out="$(wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- 2>&1)" \
                                            && log "volume down -> $out" || log "volume down FAILED: $out" ;;
        esac
      done ) &
    volpids+=($!)
    log "watching volume on $dev ($name)"
}

volume_devices() {
    local dev name
    for dev in /dev/input/event*; do
        [[ -e "$dev" ]] || continue
        name="$(cat "/sys/class/input/$(basename "$dev")/device/name" 2>/dev/null)" || continue
        case "$name" in
            *gpio-keys*|*resin*|*headset*) echo "$dev" ;;
        esac
    done
}

power_device() {
    local dev name
    for dev in /dev/input/event*; do
        [[ -e "$dev" ]] || continue
        name="$(cat "/sys/class/input/$(basename "$dev")/device/name" 2>/dev/null)" || continue
        case "$name" in *pwrkey*|*[Pp]ower\ [Bb]utton*) echo "$dev"; return 0 ;; esac
    done
    return 1
}

volpids=()
while read -r vdev; do
    [[ -n "$vdev" ]] && volume_watch "$vdev"
done < <(volume_devices)

# Swallow the wake press right after a real-suspend resume, same rebound
# guard as powerbuttond. The wake press lands within a second of resume;
# 30s of dead power button after every wake is worse than a rare double.
REBOUND_GUARD_MS=5000
# Re-suspending while the previous resume is still settling (USB dock
# touch re-enumeration, bluetooth firmware reload) is what hung a real
# V1 mini on wake - refuse a second suspend this soon after resume.
RESUSPEND_GUARD_MS=30000

RESUME_FLAG="/run/nebel/real-suspend.resumed-at"
resumed_ms_ago() {
    local at now
    [[ -r "$RESUME_FLAG" ]] || return 1
    at="$(cat "$RESUME_FLAG" 2>/dev/null)" || return 1
    [[ "$at" =~ ^[0-9]+$ ]] || return 1
    now="$(date +%s%3N)"
    echo $(( now - at ))
    return 0
}

just_resumed() {
    local ago
    ago="$(resumed_ms_ago)" || return 1
    (( ago < REBOUND_GUARD_MS ))
}

too_soon_to_resuspend() {
    local ago
    ago="$(resumed_ms_ago)" || return 1
    (( ago < RESUSPEND_GUARD_MS ))
}

pdev="$(power_device || true)"
if [[ -n "$pdev" ]]; then
    log "watching power on $pdev"
    ( evtest "$pdev" 2>/dev/null | while read -r l; do
        case "$l" in
            *"(KEY_POWER), value 1"*)
                if just_resumed; then log "post-resume rebound press ignored"
                elif too_soon_to_resuspend; then log "resumed <30s ago, suspend refused"
                elif out="$(systemctl suspend --no-block 2>&1)"; then log "power -> systemctl suspend"
                else log "power suspend FAILED: $out"; fi ;;
        esac
      done ) &
    powpid=$!
fi

trap 'kill "${volpids[@]:-}" "${powpid:-}" 2>/dev/null' EXIT INT TERM
# labwc's autostart runs us detached; exit when the compositor is gone so we
# never keep handling keys in game mode.
while :; do
    pgrep -x labwc >/dev/null 2>&1 || break
    sleep 2
done
log "labwc gone, exiting"
