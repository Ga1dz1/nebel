#!/usr/bin/bash
set -euo pipefail

export DESKTOP_SESSION=plasma
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export XDG_SESSION_TYPE=wayland
export KDE_SESSION_VERSION=6

# Ensure the KDE XDG desktop portal backend is available before Plasma/Steam
# asks for a file chooser. Stale backends from a previous desktop session can
# linger on the shared user bus, holding org.freedesktop.impl.portal.desktop.kde
# while bound to a dead display - kill them and start a fresh one through the
# systemd unit (its drop-in forces the wayland backend and restart-on-failure).
pkill -x xdg-desktop-portal-kde 2>/dev/null || true
systemctl --user reset-failed plasma-xdg-desktop-portal-kde.service 2>/dev/null || true
systemctl --user start plasma-xdg-desktop-portal-kde.service 2>/dev/null || true
# The portal frontend caches backend interfaces at startup; bounce it once the
# KDE backend is registered so FileChooser works on the very first request.
(sleep 8; systemctl --user try-restart xdg-desktop-portal.service 2>/dev/null || true) &

# In Plasma desktop mode the gamepad stays a real gamepad - the same
# controller type as game mode (default.yaml profile), so sticks are sticks
# and ABXY is ABXY everywhere, flatpaks included. Desktop navigation is
# touch; mouse/keyboard emulation is an opt-in toggle (desktop-input-mode,
# Start+Select chord). The gamepad profile is (re)loaded while Plasma runs
# and restored on exit.
GAMEPAD_PROFILE="/usr/share/inputplumber/profiles/default.yaml"
IPLUMBER_DEVICE="/org/shadowblip/InputPlumber/CompositeDevice0"
IPLUMBER_IFACE="org.shadowblip.Input.CompositeDevice"

nebel_inputplumber_profile() {
    local profile="$1"
    busctl --system call org.shadowblip.InputPlumber "${IPLUMBER_DEVICE}" "${IPLUMBER_IFACE}" LoadProfilePath s "${profile}" >/dev/null 2>&1 || true
}

# Track the active profile for desktop-input-mode status/toggle (InputPlumber
# has no D-Bus "current profile" query). /run/nebel is group-nebel writable
# (tmpfiles.d/nebel-run.conf), and this script runs as nebel.
nebel_input_mode_state() {
    echo "$1" > /run/nebel/desktop-input-mode 2>/dev/null || true
}

cleanup_plasma() {
    nebel_inputplumber_profile "${GAMEPAD_PROFILE}"
    nebel_input_mode_state gamepad
}
trap cleanup_plasma EXIT

nebel_inputplumber_profile "${GAMEPAD_PROFILE}"
nebel_input_mode_state gamepad

/usr/bin/startplasma-wayland
