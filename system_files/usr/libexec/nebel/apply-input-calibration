#!/usr/bin/python3
import json
from pathlib import Path


CONFIG = Path("/etc/nebel/input-calibration.json")
# Each supported gamepad driver exposes the same calibration parameter ABI
# (axis_*/trigger_* module params) under its own /sys/module/<name>/parameters.
# BOTH get force-loaded by modules-load.d/nebel-handheld.conf on every device,
# so first-existing is not good enough: pick by the registered input device's
# name (retroid on Retroid Pocket, rsinput on AYN devices).
DEVICE_NAME_TO_MODULE = (
    ("retroid pocket gamepad", "retroid"),
    ("rsinput", "rsinput"),
)
PARAM_NAMES = (
    "axis_leftx_min",
    "axis_leftx_center",
    "axis_leftx_max",
    "axis_leftx_deadzone",
    "axis_leftx_antideadzone",
    "axis_lefty_min",
    "axis_lefty_center",
    "axis_lefty_max",
    "axis_lefty_deadzone",
    "axis_lefty_antideadzone",
    "axis_rightx_min",
    "axis_rightx_center",
    "axis_rightx_max",
    "axis_rightx_deadzone",
    "axis_rightx_antideadzone",
    "axis_righty_min",
    "axis_righty_center",
    "axis_righty_max",
    "axis_righty_deadzone",
    "axis_righty_antideadzone",
    "trigger_left_max",
    "trigger_left_deadzone",
    "trigger_left_antideadzone",
    "trigger_right_max",
    "trigger_right_deadzone",
    "trigger_right_antideadzone",
)


def main():
    if not CONFIG.exists():
        return
    parameters = None
    for event in Path("/sys/class/input").glob("event*"):
        try:
            name = (event / "device/name").read_text(encoding="utf-8").strip().casefold()
        except OSError:
            continue
        for token, module in DEVICE_NAME_TO_MODULE:
            if token in name:
                parameters = Path(f"/sys/module/{module}/parameters")
                break
        if parameters is not None:
            break
    if parameters is None:
        for module in ("rsinput", "retroid"):
            candidate = Path(f"/sys/module/{module}/parameters")
            if candidate.exists():
                parameters = candidate
                break
    if parameters is None or not parameters.exists():
        return
    with CONFIG.open(encoding="utf-8") as f:
        params = json.load(f)
    if not isinstance(params, dict):
        raise SystemExit("input calibration config must be a JSON object")
    for name in PARAM_NAMES:
        # *_center is deliberately NOT taken from the static config: rest
        # position drifts boot-to-boot (seen +-70 counts on the same unit),
        # so nebel-gamepad-autocal re-measures centers fresh every boot.
        if name.endswith("_center"):
            continue
        if name in params:
            (parameters / name).write_text(str(int(params[name])), encoding="utf-8")
    (parameters / "update_params").write_text("1", encoding="utf-8")


if __name__ == "__main__":
    main()
