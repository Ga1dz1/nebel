def atomic_write(path, text):
    # Write through symlinks: synced configs are linked into ~/.config/nebel.
    if path.is_symlink():
        path = path.resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
    # Root writes into the synced home dir must stay user-writable so
    # Syncthing (running as the nebel user) can apply remote changes.
    if HOME_ROOT in path.parents:
        try:
            home = os.stat(HOME_ROOT)
            os.chown(path, home.st_uid, home.st_gid)
        except OSError:
            pass


def migrate_synced_configs():
    try:
        home = os.stat(HOME_ROOT)
        uid, gid = home.st_uid, home.st_gid
        SYNC_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        os.chown(SYNC_CONFIG_DIR, uid, gid)
        for name in SYNCED_CONFIG_NAMES:
            path = CONFIG_PATHS[name]
            target = SYNC_CONFIG_DIR / path.name
            if path.is_symlink():
                continue
            if path.exists():
                if target.exists():
                    # Both copies exist: the synced home copy wins.
                    path.unlink()
                else:
                    os.replace(path, target)
                    os.chown(target, uid, gid)
            path.symlink_to(target)
    except OSError:
        pass


def run(command, timeout=20):
    subprocess.run(command, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout)


def ssh_enabled():
    result = subprocess.run(
        ["/usr/bin/systemctl", "is-active", "sshd"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=5,
    )
    return result.stdout.strip() == "active"


USER_SYSTEMCTL = ["/usr/bin/systemctl", "--machine=nebel@", "--user"]


def syncthing_service_state():
    def probe(*args):
        result = subprocess.run(
            USER_SYSTEMCTL + list(args),
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        return result.stdout.strip()

    return {"enabled": probe("is-enabled", "syncthing.service") == "enabled",
            "active": probe("is-active", "syncthing.service") == "active"}


def action_set_syncthing_enabled(request):
    enabled = bool(request.get("enabled"))
    action = "enable" if enabled else "disable"
    run(USER_SYSTEMCTL + [action, "--now", "syncthing.service"], timeout=30)
    return syncthing_service_state()


def action_get_syncthing_enabled(request):
    return syncthing_service_state()


def device_env():
    result = subprocess.check_output(["/usr/libexec/nebel/device-env"], text=True, timeout=5)
    env = {}
    for line in result.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        try:
            env[key] = shlex.split(value)[0] if value else ""
        except ValueError:
            env[key] = value
    return env


def edid_display_name(card_dir):
    # Human name from the EDID monitor-name descriptor, so the UI can say
    # "Retroid Dual Screen (DP-1)" instead of a bare connector name. Best
    # effort: any parse trouble just falls back to None and the caller shows
    # the connector name.
    try:
        edid = (card_dir / "edid").read_bytes()
    except OSError:
        return None
    if len(edid) < 128:
        return None
    mfg_bits = (edid[8] << 8) | edid[9]
    mfg = "".join(chr(64 + ((mfg_bits >> shift) & 0x1F)) for shift in (10, 5, 0))
    product = edid[10] | (edid[11] << 8)
    name = ""
    for off in range(54, 126, 18):
        desc = edid[off:off + 18]
        if desc[0:3] == b"\x00\x00\x00" and desc[3] == 0xFC:
            name = desc[5:].split(b"\x0a")[0].decode("ascii", "replace").strip()
            break
    # The Retroid Dual Screen addon reports only its Lontium bridge identity
    # (CVT 0x3132, a single 1080x1920 mode) - name it for what it physically
    # is, or the UI has to show the meaningless bridge string.
    if (mfg, product) == ("CVT", 0x3132):
        return "Retroid Dual Screen"
    return name or f"{mfg} 0x{product:04X}"


def drm_connectors():
    # gamescope-session-plus/sessions.d/steam picks its output by connector
    # name (--prefer-output), so that's the unit both listing and applying a
    # choice operate on - not a friendlier "monitor 1/2" index that could
    # silently shift if a cable is unplugged between listing and applying.
    connectors = []
    drm = Path("/sys/class/drm")
    if not drm.is_dir():
        return connectors
    for card_dir in sorted(drm.glob("card*-*")):
        name = card_dir.name.split("-", 1)[1]
        # Kernel writeback connectors are virtual capture endpoints, never a
        # display - one showed up in the UI as "Writeback-1" and was mistaken
        # for the actual external screen.
        if name.startswith("Writeback"):
            continue
        status_path = card_dir / "status"
        if not status_path.is_file():
            continue
        try:
            status = status_path.read_text(encoding="utf-8").strip()
        except OSError:
            continue
        modes = []
        modes_path = card_dir / "modes"
        if modes_path.is_file():
            seen = set()
            try:
                for line in modes_path.read_text(encoding="utf-8").splitlines():
                    line = line.strip()
                    if line and line not in seen:
                        seen.add(line)
                        modes.append(line)
            except OSError:
                pass
        entry = {"connector": name, "connected": status == "connected", "modes": modes}
        display_name = edid_display_name(card_dir)
        if display_name:
            entry["name"] = display_name
        connectors.append(entry)
    return connectors


def action_list_displays(request):
    primary = device_env().get("NEBEL_PRIMARY_CONNECTOR", "")
    connectors = drm_connectors()
    for c in connectors:
        c["internal"] = c["connector"] == primary
    return {"connectors": connectors, "primaryConnector": primary}


def _display_remembered():
    try:
        data = json.loads(DISPLAY_REMEMBERED_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    # Writeback entries are junk from before those virtual connectors were
    # filtered out of the listing - drop them here too (and this dict is what
    # gets rewritten on the next set_display_config, so it self-cleans).
    return {k: v for k, v in data.items() if not k.startswith("Writeback")}


def action_get_display_config(request):
    remembered = _display_remembered()
    if not DISPLAY_OVERRIDE_PATH.exists():
        return {"useExternal": False, "remembered": remembered}
    values = {}
    try:
        for line in DISPLAY_OVERRIDE_PATH.read_text(encoding="utf-8").splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                values[key] = value
    except OSError:
        return {"useExternal": False, "remembered": remembered}
    return {
        "useExternal": True,
        "connector": values.get("NEBEL_DISPLAY_CONNECTOR", ""),
        "width": int(values.get("NEBEL_DISPLAY_WIDTH") or 0),
        "height": int(values.get("NEBEL_DISPLAY_HEIGHT") or 0),
        "orientation": values.get("NEBEL_DISPLAY_ORIENTATION", "normal"),
        "remembered": remembered,
    }


def action_set_display_config(request):
    if not bool(request.get("useExternal")):
        # Only the active choice is cleared - the remembered per-connector
        # settings survive so picking the same monitor later restores them.
        try:
            DISPLAY_OVERRIDE_PATH.unlink()
        except FileNotFoundError:
            pass
        return {"ok": True}

    connector = str(request.get("connector", ""))
    orientation = str(request.get("orientation", "normal"))
    if not re.fullmatch(r"[A-Za-z0-9_-]+", connector):
        raise ValueError("invalid connector")
    if orientation not in DISPLAY_ORIENTATIONS:
        raise ValueError("invalid orientation")
    try:
        width = int(request.get("width"))
        height = int(request.get("height"))
    except (TypeError, ValueError):
        raise ValueError("invalid resolution")
    if not (0 < width <= 16384 and 0 < height <= 16384):
        raise ValueError("invalid resolution")
    # Portrait is valid only together with a rotation (the Retroid Dual
    # Screen case - 1080x1920 panel mounted landscape, rotated by gamescope's
    # --force-external-orientation); portrait without one can only be a
    # mistake, and sessions.d/steam would ignore the override anyway.
    if width < height and orientation == "normal":
        raise ValueError("a portrait mode requires a rotation")

    text = (
        f"NEBEL_DISPLAY_CONNECTOR={connector}\n"
        f"NEBEL_DISPLAY_WIDTH={width}\n"
        f"NEBEL_DISPLAY_HEIGHT={height}\n"
        f"NEBEL_DISPLAY_ORIENTATION={orientation}\n"
    )
    atomic_write(DISPLAY_OVERRIDE_PATH, text)
    remembered = _display_remembered()
    remembered[connector] = {"width": width, "height": height, "orientation": orientation}
    atomic_write(DISPLAY_REMEMBERED_PATH, json.dumps(remembered, separators=(",", ":")))
    return {"ok": True}


def action_restart_gamescope_session(request):
    # Output connector/resolution/rotation are gamescope startup flags (see
    # sessions.d/steam) - applying a new display choice needs the session
    # relaunched, not just the config file rewritten. Shared with
    # nebel-display-hotplug's disconnect fallback (see that script's own
    # comment, and restart-gamescope-session's, for why this can't just be
    # session-control's switch-gamemode).
    run(["/usr/libexec/nebel/restart-gamescope-session"], timeout=15)
    return {"ok": True}


def action_start_dualscreen_session(request):
    # Dual-screen emulator session (labwc driving internal+external at once,
    # for Azahar/melonDS). session-control rewrites the sddm autologin and
    # restarts it; start-dualscreen itself falls back to game mode when no
    # external display is connected, and the session returns to game mode
    # when the app exits.
    run(["/usr/libexec/nebel/session-control", "switch-dualscreen"], timeout=15)
    return {"ok": True}


INTERNAL_TOUCHPAD_CONF = Path("/etc/nebel/internal-touchpad.conf")
INTERNAL_TOUCHPAD_SERVICE = "nebel-internal-touchpad.service"
# Dropped by sessions.d/steam when game mode actually launched with an
# external display as primary - the only layout where the pass-through
# daemon may run (it grabs the internal digitizer). Resolved across all
# logged-in user runtime dirs: this backend can run as root (Decky talks to
# the root control socket), where XDG_RUNTIME_DIR/getuid would point at
# /run/user/0 and the marker would never be found - the toggle then fell
# into the stop branch and killed the daemon on every enable.
EXTERNAL_PRIMARY_MARKER = Path(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
) / "nebel-external-primary"


def _external_primary_active():
    if EXTERNAL_PRIMARY_MARKER.exists():
        return True
    try:
        return any(Path("/run/user").glob("*/nebel-external-primary"))
    except OSError:
        return False


def _internal_touchpad_enabled():
    # Default OFF (plain touchscreen), matching the daemon's own default:
    # the Deck-trackpad split is opt-in until the InputPlumber deck chain is
    # confirmed working end to end.
    try:
        for line in INTERNAL_TOUCHPAD_CONF.read_text(encoding="utf-8").splitlines():
            if line.startswith("ENABLED="):
                return line.split("=", 1)[1].strip() != "0"
    except OSError:
        pass
    return False


def action_get_internal_touchpad(request):
    return {"enabled": _internal_touchpad_enabled()}


def action_set_internal_touchpad(request):
    enabled = bool(request.get("enabled"))
    atomic_write(INTERNAL_TOUCHPAD_CONF, f"ENABLED={1 if enabled else 0}\n")
    # The daemon re-reads the conf on restart and picks its output node
    # itself (trackpad split vs rotated touchscreen), so the toggle is just
    # a restart - a mode switch, never a kill switch. The service may always
    # run while the toggle is on, with or without an external display: it
    # only owns the digitizer when it actually grabs it, and the user asked
    # for the touchpad mode to be usable standalone (the OFF branch still
    # stops it and restores raw touch).
    name = device_env().get("NEBEL_INTERNAL_TOUCHSCREEN", "")
    if name:
        run(["/usr/libexec/nebel/touchscreen-inhibit", name, "0"])
    run(USER_SYSTEMCTL + ["restart", INTERNAL_TOUCHPAD_SERVICE])
    return {"enabled": enabled}


