#!/bin/bash
set -euo pipefail

eval "$(/usr/libexec/nebel/device-env)"

# AYANEO Pocket MCUs need this serial frame to switch to fake-Xbox-360 mode
# (045e:028e); without it the kernel can't drive the controller.
ayaneo_xbox_mode() {
    local serial_device=/dev/ttyHS0

    if [[ ! -e "$serial_device" ]]; then
        echo "device-quirks: $serial_device not present, skipping AYANEO Xbox mode"
        return 0
    fi

    stty -F "$serial_device" 115200 -clocal -opost -isig -icanon -echo
    printf '\xe7\x55\x05\x01\x00\x00\x00\x00\x00\x5b\xed' >"$serial_device"
    sleep 0.1
    printf '\x35\x35\x30\x35\x30\x31\x30\x30\x30\x30\x30\x30\x30\x30\x30\x30' >"$serial_device"
    sleep 0.1

    echo "device-quirks: AYANEO MCU switched to Xbox 360 mode"
}

case "${NEBEL_GAMEPAD_QUIRK:-none}" in
    ayaneo-xbox)
        ayaneo_xbox_mode
        ;;
    none)
        ;;
esac

# fake-suspend keeps wifi associated; real suspend needs NM to drop and reconnect.
if [[ "${NEBEL_SUSPEND_MODE:-fake}" != "fake" ]]; then
    rm -f /etc/NetworkManager/ignore-sleep
fi

# SM8550 (A740): CPU0's deep power-collapse C-state wedges the GMU; disable it.
if [[ "${NEBEL_SOC_CLASS:-}" == "SM8550" ]]; then
    echo 1 >/sys/devices/system/cpu/cpu0/cpuidle/state1/disable
fi

# SM8250's qdsp6 DSP path crackles at nebel's shared 512-sample default (see
# /usr/share/pipewire/*.conf.d/99-nebel-buffers.conf); ROCKNIX's own kernel
# patch (0012-ASoC-qcom-q6asm-dai) and pipewire-pulse defaults both use 1024.
# Runs before any user session (hence pipewire) starts, so this is in place
# for pipewire's first-ever startup, not just subsequent boots.
if [[ "${NEBEL_SOC_CLASS:-}" == "SM8250" ]]; then
    mkdir -p /etc/pipewire/pipewire.conf.d /etc/pipewire/pipewire-pulse.conf.d
    cat >/etc/pipewire/pipewire.conf.d/99-nebel-sm8250-buffers.conf <<'EOF'
context.properties = {
    default.clock.min-quantum = 1024
}
EOF
    cat >/etc/pipewire/pipewire-pulse.conf.d/99-nebel-sm8250-buffers.conf <<'EOF'
pulse.properties = {
    pulse.min.req     = 1024/48000
    pulse.min.quantum = 1024/48000
    pulse.min.frag    = 1024/48000
}
EOF
fi

# HTR3212-driven stick RGB (4 zones per stick, r/g/b each) has no userspace
# owner and sits off since boot otherwise. Apply the saved static color or
# battery-reactive color (see stick-led-color and the nebel-stick-led
# service that keeps battery mode tracking the charge level). Retroid Pocket
# 5 and Flip2 share the same LED zone layout in their device tree as Mini
# V2 (unverified on real hardware, but the DTS nodes match). Retroid Pocket
# 6 is confirmed on real hardware to have the identical /sys/class/leds/l:r1
# etc. zone layout, despite being a different SoC (SM8550) and gamepad MCU.
case "${NEBEL_DEVICE_ID:-}" in
    retroid-pocket-mini-v2 | retroid-pocket-5 | retroid-pocket-flip2 | retroid-pocket-6)
        /usr/libexec/nebel/stick-led-color apply || true
        ;;
esac

# Flip2 only: this board's shared-MCU gamepad has no physical button wired
# to BTN_BACK, so its InputPlumber capability map (retroid_flip2_qam_chord,
# see 01-retroid-flip2-controller.yaml) opens Steam's Quick Access Menu via
# a Guide+A chord instead. The MCU reports Guide (BTN_MODE) as a fixed
# ~150ms pulse no matter how long it's held, too short a window for the
# chord matcher to reliably catch - the kernel's home_pulse_stretch_ms
# param (see 1005-retroid-gamepad-home-pulse-stretch.patch) defers the
# release edge to widen it. Defaults off (0) for every other device using
# this same driver (Mini V2, RP5, RP6's own gamepad path), since it changes
# real Guide-button release timing and has no reason to apply where a
# physical QAM button already works. 400ms ported from pocknix-os's own
# figure - like their own implementation, unconfirmed on real Flip2
# hardware as of this commit.
if [[ "${NEBEL_DEVICE_ID:-}" == "retroid-pocket-flip2" ]]; then
    param=/sys/module/retroid/parameters/home_pulse_stretch_ms
    [[ -w "$param" ]] && echo 400 >"$param"
fi

# RP6 (SM8550), Mini V1/V2 (SM8250): the battery fuel gauge and Qualcomm
# battery-manager psy devices keep their wake IRQs armed, and on charger they
# fire on every charge-status tick, bouncing the console out of suspend
# seconds after entry. Confirmed on hardware via /var/log/nebel-suspend cycle
# logs: every instant-wake cycle had +1..3 `battery` wakeups, pwrkey none;
# with these disabled both consoles sleep on charger normally. Their wake
# buys us nothing (the PMIC handles low-battery protection in hardware), so
# turn it off. The ucsi/tcpm source psy stays enabled: plugging the charger
# in during sleep still wakes the console to show charging. Other Retroids
# share the same PMIC stack but are unverified - not included until tested.
if [[ "${NEBEL_DEVICE_ID:-}" == "retroid-pocket-6" || "${NEBEL_DEVICE_ID:-}" == "retroid-pocket-mini" || "${NEBEL_DEVICE_ID:-}" == "retroid-pocket-mini-v2" ]]; then
    for w in /sys/class/wakeup/wakeup*; do
        case "$(cat "$w/name" 2>/dev/null)" in
            battery | qcom-battmgr-usb | qcom-battmgr-wls)
                [[ -w "$w/device/power/wakeup" ]] && echo disabled >"$w/device/power/wakeup"
                ;;
        esac
    done
fi
