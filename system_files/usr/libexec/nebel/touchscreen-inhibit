#!/usr/bin/bash
# Inhibit (1) or re-enable (0) an input device by name. Used to silence the
# secondary touchscreen while gamescope owns the only visible screen.
# (ported from upstream virtudude/armada 7752e05)
#
# The name is matched as a PREFIX: the kernel decorates some input names with
# an instance suffix ("generic ft5x06 (8d)"), and that suffix is not stable
# across units/boots, so exact matching would silently stop working.
set -euo pipefail

name="${1:?usage: touchscreen-inhibit <device-name> <1|0>}"
state="${2:?usage: touchscreen-inhibit <device-name> <1|0>}"

for dev in /sys/class/input/input*/; do
    [[ "$(cat "${dev}name" 2>/dev/null)" == "${name}"* ]] || continue
    echo "${state}" > "${dev}inhibited"
done
