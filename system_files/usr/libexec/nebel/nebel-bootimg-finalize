#!/bin/bash
# Regenerate /KERNEL after OSTree finalizes a staged deployment.
# bootc is bootloader=none; without this, upgrades/rollbacks would not take
# effect because the ABL keeps booting the old /KERNEL.
set -uo pipefail

status=0

if ! /usr/libexec/nebel/nebel-bootimg-update; then
    bootimg_status=$?
    echo "nebel-bootimg-finalize: boot image update failed (${bootimg_status})" >&2
    status=$bootimg_status
fi

(( status == 0 )) && exit 0

echo "nebel-bootimg-finalize: rolling back deployment" >&2
if /usr/bin/bootc rollback; then
    echo "nebel-bootimg-finalize: deployment rollback succeeded" >&2
else
    rollback_status=$?
    echo "nebel-bootimg-finalize: deployment rollback failed (${rollback_status})" >&2
fi
exit "${status}"
