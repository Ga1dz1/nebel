#!/usr/bin/bash
# desktop-input-mode {gamepad|mouse|status|toggle}
#
# In Plasma desktop mode the gamepad stays a real gamepad (default.yaml) -
# the same controller type as game mode, so sticks are sticks and ABXY is
# ABXY everywhere, flatpaks included. Mouse/keyboard emulation is the
# opt-in exception for apps without touch support, toggled on the fly:
#
#   gamepad -> default.yaml        (1:1 passthrough to the virtual pad)
#   mouse   -> mouse_keyboard.yaml (desktop mouse/keys emulation)
#
# No target-device or session restart needed: session-control keeps the
# controller target plus mouse+keyboard attached in desktop mode precisely
# so this profile flip is enough.
# State is tracked in /run/nebel/desktop-input-mode because InputPlumber
# exposes no "current profile" query over D-Bus.
set -euo pipefail

STATE=/run/nebel/desktop-input-mode
DEVICE=/org/shadowblip/InputPlumber/CompositeDevice0
IFACE=org.shadowblip.Input.CompositeDevice
GAMEPAD_PROFILE=/usr/share/inputplumber/profiles/default.yaml
MOUSE_PROFILE=/usr/share/inputplumber/profiles/mouse_keyboard.yaml

current() {
    # Default is gamepad (see start-plasma); a missing state file means the
    # desktop session just started and the gamepad profile is loaded.
    cat "$STATE" 2>/dev/null || echo gamepad
}

apply() {
    busctl --system call org.shadowblip.InputPlumber "$DEVICE" "$IFACE" \
        LoadProfilePath s "$1" >/dev/null 2>&1 || true
    mkdir -p /run/nebel
    echo "$2" > "$STATE"
}

case "${1:-}" in
    gamepad) apply "$GAMEPAD_PROFILE" gamepad ;;
    mouse)   apply "$MOUSE_PROFILE" mouse ;;
    status)  current ;;
    toggle)
        if [[ "$(current)" == gamepad ]]; then
            exec "$0" mouse
        else
            exec "$0" gamepad
        fi
        ;;
    *) echo "usage: $0 {gamepad|mouse|status|toggle}" >&2; exit 1 ;;
esac
