#!/bin/bash
# One-time rename of the legacy "armada" user to "nebel" after an OTA from an
# armada-era image. Runs very early (before sddm), when the user has no
# processes and no active session.
#
# Two cases, because systemd-sysusers runs before us and creates the "nebel"
# user (plus a root-owned /var/home/nebel) right from the new image config:
#   1. only "armada" exists          -> full usermod rename (home moved by -m)
#   2. "nebel" already exists, but the legacy /var/home/armada survived
#      -> adopt the legacy home into /var/home/nebel instead of the fresh one
set -u

new_home=/var/home/nebel
legacy_home=/var/home/armada
sweep_stamp="$new_home/.local/share/nebel/.legacy-paths-swept"

# Config files created while the home was still /var/home/armada keep absolute
# paths to it (Dolphin's user-places.xbel is the visible one - its places
# panel ends up full of dead bookmarks). Rewrite them in small text files
# under the usual config/data dirs. Runs once per install (stamp file), for
# fresh migrators and for boxes that migrated before this sweep existed.
sweep_legacy_paths() {
    [ -d "$new_home" ] || return 0
    [ -e "$sweep_stamp" ] && return 0
    while IFS= read -r f; do
        sed -i "s|/var/home/armada|${new_home}|g" "$f" 2>/dev/null || true
    done < <(grep -rIl --binary-files=without-match -m1 "/var/home/armada" \
        "$new_home/.config" "$new_home/.local/share" 2>/dev/null || true)
    mkdir -p "$(dirname "$sweep_stamp")"
    touch "$sweep_stamp"
    chown -R nebel:nebel "$(dirname "$sweep_stamp")" 2>/dev/null || true
}

if ! id -u nebel &>/dev/null; then
    id -u armada &>/dev/null || exit 0
    loginctl kill-user armada 2>/dev/null || true
    groupmod -n nebel armada 2>/dev/null || true
    usermod -l nebel -d "$new_home" -m armada || exit 1
elif [ -d "$legacy_home" ]; then
    loginctl kill-user nebel 2>/dev/null || true
    # Merge legacy home over the fresh one (old data wins), then drop it.
    cp -a "$legacy_home"/. "$new_home"/ || exit 1
    rm -rf "$legacy_home"
else
    # Already migrated - just make sure the one-time path sweep happened.
    sweep_legacy_paths
    exit 0
fi

chown -R nebel:nebel "$new_home"
restorecon -R "$new_home" 2>/dev/null || true
echo 'nebel:nebel' | chpasswd
rm -f /etc/sudoers.d/armada-user
sweep_legacy_paths
# Re-apply sysusers so group memberships from the new config are in place.
systemd-sysusers || true
