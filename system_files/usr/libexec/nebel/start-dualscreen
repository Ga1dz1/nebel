#!/usr/bin/bash
# Dual-screen emulator session for Nebel handhelds.
#
# Drives BOTH the internal panel and an external display (Retroid Dual
# Screen addon) at once - the one thing the gamescope game-mode session
# physically can't do (single-output compositor and sole DRM master on the
# MSM card, so "a second compositor next to it" isn't possible either).
# labwc (wlroots) has no such limitation: two wl_outputs, per-output touch
# binding, and plain window placement - exactly what dual-screen emulators
# (Azahar/3DS, melonDS/DS) need: top screen on the external display,
# bottom (touch) screen on the internal panel.
#
# Flow: session-control switch-dualscreen -> sddm -> this script. The app
# (default: Azahar flatpak, override via /etc/nebel/dualscreen-app.conf)
# autostarts; when it exits, the session returns to game mode on its own.
# If no external display is connected there is nothing dual to show -
# fall straight back to game mode instead of stranding the user.
set -uo pipefail

# A previous labwc instance can survive an sddm restart as an orphan and
# still hold the seat/DRM master; a fresh labwc then dies instantly with
# seatd's "seat is VT-bound and has an active client". Clean leftovers first.
pkill -u "$(id -u)" -x labwc 2>/dev/null || true
pkill -u "$(id -u)" -x kanshi 2>/dev/null || true
pkill -u "$(id -u)" -f nebel-dualscreen-exit 2>/dev/null || true
sleep 1

# This session is one-shot: arm game mode as the next autologin session
# BEFORE anything can exit/crash, so sddm always lands back in game mode
# without respawning dualscreen first (that race looked like a reboot).
sudo -n /usr/libexec/nebel/session-control default-gamemode 2>/dev/null || true

eval "$(/usr/libexec/nebel/device-env)"

INTERNAL="${NEBEL_PRIMARY_CONNECTOR:-DSI-1}"
PANEL_ORIENT="${NEBEL_PANEL_ORIENTATION:-normal}"
INT_TOUCH="${NEBEL_INTERNAL_TOUCHSCREEN:-}"
EXT_TOUCHES="${NEBEL_EXTERNAL_TOUCHSCREENS:-}"
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}/nebel-dualscreen"

connected() {
    local f
    for f in /sys/class/drm/card*-"$1"/status; do
        [[ -f "$f" ]] || continue
        [[ "$(cat "$f" 2>/dev/null)" == "connected" ]] && return 0
    done
    return 1
}

# The external connector: prefer the Decky display override's choice,
# otherwise the first connected non-internal connector.
EXT=""
EXT_ORIENT="left"
if [[ -f /etc/nebel/display-override.conf ]]; then
    # shellcheck source=/dev/null
    source /etc/nebel/display-override.conf
    EXT="${NEBEL_DISPLAY_CONNECTOR:-}"
    EXT_ORIENT="${NEBEL_DISPLAY_ORIENTATION:-left}"
fi
if [[ -z "$EXT" ]] || ! connected "$EXT"; then
    EXT=""
    for f in /sys/class/drm/card*-*/status; do
        [[ -f "$f" ]] || continue
        [[ "$(cat "$f" 2>/dev/null)" == "connected" ]] || continue
        name=$(basename "$f")
        name="${name#*-}"
        [[ "$name" == "$INTERNAL" || "$name" == Writeback-* ]] && continue
        EXT="$name"
        break
    done
fi

if [[ -z "$EXT" ]]; then
    echo "start-dualscreen: no external display connected - back to game mode" >&2
    exit 0  # autologin is already armed to game mode
fi

# wlroots/kanshi transform for our orientation names (90 = counterclockwise
# per wl_output_transform, matching gamescope's "left").
wl_transform() {
    case "$1" in
        left)     echo 90 ;;
        right)    echo 270 ;;
        inverted) echo 180 ;;
        *)        echo normal ;;
    esac
}

# Gamepad as a real controller: user's chosen emulation type as targets and
# the 1:1 passthrough profile (no mouse/keyboard mapping in this session).
/usr/libexec/nebel/controller-type apply >/dev/null 2>&1 || true
for path in $(busctl --system tree org.shadowblip.InputPlumber 2>/dev/null \
        | grep -oE '/org/shadowblip/InputPlumber/CompositeDevice[0-9]+' | sort -u); do
    busctl --system call org.shadowblip.InputPlumber "$path" \
        org.shadowblip.Input.CompositeDevice LoadProfilePath s \
        /usr/share/inputplumber/profiles/default.yaml >/dev/null 2>&1 || true
done

mkdir -p "$RUN_DIR"

# The game-mode session may have inhibited the internal digitizer ("internal
# screen as touchpad" = off disables it entirely); here it is the bottom
# screen's touch, so always re-enable it for this session.
[[ -n "$INT_TOUCH" ]] && /usr/libexec/nebel/touchscreen-inhibit "$INT_TOUCH" 0 2>/dev/null || true

# labwc matches <touch deviceName> exactly, but the kernel decorates some
# input names with an unstable instance suffix ("generic ft5x06 (8d)") -
# resolve the full name by prefix, same as touchscreen-inhibit does.
# The RDS addon's USB touch flaps (disconnect bursts); if it is absent at
# session start, fall back to the undecorated prefix so the mapping still
# lands in rc.xml and binds when the device reappears.
resolve_touch() {
    local prefix="$1" n
    for d in /sys/class/input/input*/name; do
        n=$(cat "$d" 2>/dev/null) || continue
        case "$n" in "$prefix"*) echo "$n"; return 0 ;; esac
    done
    echo "$prefix"
}

# Physical layout: the addon sits ON TOP of the device, so stack the outputs
# vertically - external (top screen) above the internal panel (bottom, touch).
# The addon is 1920x1080; rotated 90/270 its logical height is 1920.
cat > "$RUN_DIR/kanshi.conf" <<EOF
profile {
    output $EXT enable transform $(wl_transform "$EXT_ORIENT") position 0,0
    output $INTERNAL enable transform $(wl_transform "$PANEL_ORIENT") position 0,1920
}
EOF

# labwc does NOT rotate touch with the output transform by itself (wlroots
# maps normalized coords straight onto the logical output box) - it needs a
# libinput calibrationMatrix matching the output rotation. Raw corner-tap
# capture on the Mini V2 (ft5x06) gives raw = (1-py, px) in physical-as-seen
# space, so "0 1 0 -1 0 1" maps raw onto exactly what the user sees. It is
# also what the RDS hwdb rule sets for the addon, so this stays consistent.
# NOTE: labwc matches libinput device blocks by the *category* attribute
# (<device category="...">) - a "name" attribute is silently ignored and the
# matrix then lands in the default category, hitting every input device.
# /etc/nebel/dualscreen-touch.conf may override INT_MATRIX/EXT_MATRIX.
matrix_for() {
    # Measured with raw evdev corner taps + labwc marker menu on the Mini V2
    # (ft5x06, panel orientation "right", output transform 270): the extra
    # rotation the compositor applies exactly cancels the digitizer's native
    # rotation, so the internal touch needs NO matrix (identity).
    # "left" (RP6 / RDS addon output): keep parity with the RDS hwdb rule.
    case "$1" in
        left)     echo "0 1 0 -1 0 1" ;;
        right)    echo "" ;;
        inverted) echo "-1 0 1 0 -1 1" ;;
        *)        echo "" ;;
    esac
}
INT_MATRIX=$(matrix_for "$PANEL_ORIENT")
EXT_MATRIX=$(matrix_for "$EXT_ORIENT")
if [[ -f /etc/nebel/dualscreen-touch.conf ]]; then
    # shellcheck source=/dev/null
    source /etc/nebel/dualscreen-touch.conf
fi

# Per-output touch binding: the internal panel's digitizer serves the
# bottom screen, the addon's digitizer serves the top one.
{
    echo '<?xml version="1.0"?>'
    echo '<labwc_config>'
    INT_TOUCH_FULL=""
    if [[ -n "$INT_TOUCH" ]]; then
        INT_TOUCH_FULL=$(resolve_touch "$INT_TOUCH")
        [[ -n "$INT_TOUCH_FULL" ]] && echo "  <touch deviceName=\"$INT_TOUCH_FULL\" mapToOutput=\"$INTERNAL\"/>"
    fi
    declare -a EXT_TOUCH_FULL=()
    while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        t_full=$(resolve_touch "$t")
        [[ -n "$t_full" ]] || continue
        EXT_TOUCH_FULL+=("$t_full")
        echo "  <touch deviceName=\"$t_full\" mapToOutput=\"$EXT\"/>"
    done <<< "$(echo "$EXT_TOUCHES" | tr ',' '\n')"
    # Rotation matrices matching each output's transform (or the overrides).
    echo '  <libinput>'
    if [[ -n "$INT_TOUCH_FULL" && -n "$INT_MATRIX" ]]; then
        echo "    <device category=\"$INT_TOUCH_FULL\"><calibrationMatrix>$INT_MATRIX</calibrationMatrix></device>"
    fi
    for t_full in ${EXT_TOUCH_FULL[@]+"${EXT_TOUCH_FULL[@]}"}; do
        [[ -n "$EXT_MATRIX" ]] && echo "    <device category=\"$t_full\"><calibrationMatrix>$EXT_MATRIX</calibrationMatrix></device>"
    done
    echo '  </libinput>'
    # Emulator windows: fullscreen wherever they land.
    echo '  <windowRules>'
    for id in melonds melonDS net.kuribo64.melonDS; do
        echo "    <windowRule identifier=\"$id\"><action name=\"ToggleFullscreen\"/></windowRule>"
    done
    # Azahar runs two windows: the main one (3DS top screen) belongs on the
    # addon up top, the secondary one (3DS bottom screen) on the internal
    # panel below, whose digitizer is the touch input. Rules apply on first
    # map in document order and a window matches every fitting rule, so:
    # general rules place BOTH azahar windows on the internal output, then
    # the matchOnce rule moves only the first-mapped (main) window to the
    # addon. Fullscreen is NOT toggled here on purpose: Azahar re-applies
    # its saved Qt window state after mapping, which would silently revert
    # it - azahar-x11-fullscreen sends the fullscreen client message once
    # the windows settle (same as pressing F11 by hand).
    for id in azahar Azahar org.azahar_emu.Azahar; do
        echo "    <windowRule identifier=\"$id\"><action name=\"MoveToOutput\" output=\"$INTERNAL\"/></windowRule>"
    done
    for id in azahar Azahar org.azahar_emu.Azahar; do
        echo "    <windowRule identifier=\"$id\" matchOnce=\"yes\"><action name=\"MoveToOutput\" output=\"$EXT\"/></windowRule>"
    done
    echo '  </windowRules>'
    echo '</labwc_config>'
} > "$RUN_DIR/rc.xml"

APP_CMD_DEFAULT='flatpak run org.azahar_emu.Azahar'
# A per-game request (written by nebel-game-launch when the game's
# "Dual-screen mode" toggle is on) wins over the /etc override; it is
# consumed once so the next manual session start uses the default again.
RUNTIME_CONF="${XDG_RUNTIME_DIR:-/run/user/1000}/nebel-dualscreen-app.conf"
if [[ -f "$RUNTIME_CONF" ]]; then
    # shellcheck source=/dev/null
    source "$RUNTIME_CONF"
    rm -f "$RUNTIME_CONF"
elif [[ -f /etc/nebel/dualscreen-app.conf ]]; then
    # shellcheck source=/dev/null
    source /etc/nebel/dualscreen-app.conf
fi
APP_CMD="${APP_CMD:-$APP_CMD_DEFAULT}"

# Flatpak socket fixups for this Wayland-only session:
# - Azahar's Vulkan Wayland path dies with a linux-drm-syncobj protocol
#   error under labwc ("surface has been destroyed" when the game window
#   opens) while KWin tolerates it - run it through XWayland instead.
# - Other flatpaks often ship X11-only socket permissions - grant the
#   Wayland socket on the fly (idempotent).
if [[ "$APP_CMD" =~ flatpak\ run\ ([^\ ]+) ]]; then
    app_id="${BASH_REMATCH[1]}"
    if [[ "$app_id" == "org.azahar_emu.Azahar" ]]; then
        flatpak override --user "$app_id" --socket=x11 --nosocket=wayland >/dev/null 2>&1 || true
        APP_CMD="env QT_QPA_PLATFORM=xcb $APP_CMD"
        # Compositor-forced fullscreen resizes the window but Qt keeps
        # drawing the menu/status bars - only Azahar's own fullscreen mode
        # (F11) hides them. Seed it in the config for this session and
        # restore the saved value when the session ends. Wait for a leftover
        # Azahar from the previous session first: it saves the config on
        # exit and would otherwise overwrite the seeded value.
        AZAHAR_CONF="$HOME/.var/app/org.azahar_emu.Azahar/config/azahar-emu/qt-config.ini"
        for _ in $(seq 1 20); do
            pgrep -x azahar >/dev/null 2>&1 || break
            sleep 0.5
        done
        if [[ -f "$AZAHAR_CONF" ]] && grep -q '^fullscreen=false$' "$AZAHAR_CONF"; then
            sed -i 's/^fullscreen=false$/fullscreen=true/' "$AZAHAR_CONF"
            azahar_restore_fullscreen=1
        fi
        # No shell in this session means nothing hides the X cursor Azahar
        # draws over its window - let Azahar's own "hide on inactivity"
        # option do it. Left as-is on session end (it is a sane default on
        # the desktop too).
        if [[ -f "$AZAHAR_CONF" ]] && grep -q '^hideInactiveMouse=false$' "$AZAHAR_CONF"; then
            sed -i 's/^hideInactiveMouse=false$/hideInactiveMouse=true/' "$AZAHAR_CONF"
        fi
    else
        flatpak override --user "$app_id" --socket=wayland >/dev/null 2>&1 || true
    fi
fi

# labwc runs its <config-dir>/autostart via sh once the Wayland socket is
# up, so kanshi and the app are launched from there. The trailing watcher
# drops labwc (and thus the session) when the app exits.
cat > "$RUN_DIR/autostart" <<EOF
#!/bin/sh
kanshi -c "$RUN_DIR/kanshi.conf" >"$RUN_DIR/kanshi.log" 2>&1 &
/usr/libexec/nebel/nebel-dualscreen-exit >"$RUN_DIR/exit-watch.log" 2>&1 &
$( [[ "$APP_CMD" == *azahar* ]] && echo "/usr/libexec/nebel/azahar-x11-fullscreen >/dev/null 2>&1 &" )
( sleep 2; $APP_CMD >"$RUN_DIR/app.log" 2>&1; echo "APP_EXIT_CODE=\$?" >>"$RUN_DIR/app.log"; sleep 1; labwc --exit 2>/dev/null || killall labwc ) &
EOF
chmod +x "$RUN_DIR/autostart"

export QT_QPA_PLATFORM="wayland;xcb"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc
# Software cursor: the panel's hardware cursor plane mishandles rotation,
# and a visible pointer is needed for touch testing (mouseEmulation).
export WLR_NO_HARDWARE_CURSORS=1

/usr/bin/labwc -C "$RUN_DIR" >"$RUN_DIR/labwc.log" 2>&1

# labwc exited (app quit, exit hotkey, or a crash). The autologin entry was
# armed to game mode at session start, so sddm's autologin takes us back
# there on its own - nothing left to do here.
if [[ "${azahar_restore_fullscreen:-0}" == 1 ]]; then
    sed -i 's/^fullscreen=true$/fullscreen=false/' "$AZAHAR_CONF"
fi
