#!/usr/bin/bash
set -euo pipefail

steam_args=()
if [[ ${1:-} == "--desktop" ]]; then
    shift
    steam_args=(-steamdeck)
fi

steam_root="${STEAM_ROOT:-${HOME}/.local/share/Steam}"
steam_arm_dir="${steam_root}/steamrtarm64"
steam_arm="${steam_arm_dir}/steam"
steam_shim_dir="${steam_root}/lib/aarch64-linux-gnu"
steam_runtime_bin="${steam_root}/steam-runtime-steamrt-arm64/bin"

if [[ ! -x "${steam_arm}" ]]; then
    echo "ERROR: native ARM Steam is missing or not executable: ${steam_arm}" >&2
    exit 127
fi

steam_ld_path="${steam_arm_dir}"
if [[ -d "${steam_shim_dir}" ]]; then
    steam_ld_path="${steam_ld_path}:${steam_shim_dir}"
fi
export LD_LIBRARY_PATH="${steam_ld_path}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
if [[ -d "${steam_runtime_bin}" ]]; then
    export PATH="${steam_runtime_bin}:${PATH}"
fi
export FUSERMOUNT_PROG=/run/host/usr/bin/fusermount3

steamapps_dirs=("${steam_root}/steamapps")
while IFS= read -r library; do
    steamapps="${library}/steamapps"
    [[ -d "${steamapps}" ]] || continue
    steamapps_dirs+=("${steamapps}")
done < <(grep -oP '"path"\s+"\K[^"]+' "${steam_root}/steamapps/libraryfolders.vdf" 2>/dev/null || true)

# Register the official ARM64 Protons before Steam scans compatibilitytools.d.
# The ARM client's catalog enumeration of Valve's ARM64 tools (4628740,
# 4427310) is unreliable across devices - on some consoles they never show up
# in compat pickers despite being fully installed. Our aliases point at the
# same content and always register.
register_arm64_proton() {
    local appid="$1" dirname="$2" tool_id="$3" vdf_key="$4" display="$5"
    local runner="" reg="${steam_root}/compatibilitytools.d/${tool_id}"
    for steamapps in "${steamapps_dirs[@]}"; do
        local candidate="${steamapps}/common/${dirname}"
        local flags
        flags="$(grep -oP '"StateFlags"\s+"\K[0-9]+' "${steamapps}/appmanifest_${appid}.acf" 2>/dev/null || true)"
        if [[ -n "${flags}" ]] && (( flags & 4 )) && [[ -d "${candidate}" ]]; then
            runner="${candidate}"
            break
        fi
    done
    if [[ -n "${runner}" ]]; then
        mkdir -p "${reg}"
        cat > "${reg}/compatibilitytool.vdf" <<EOF
"compatibilitytools"
{
  "compat_tools"
  {
    "${vdf_key}"
    {
      "install_path" "${runner}"
      "display_name" "${display}"
      "from_oslist"  "windows"
      "to_oslist"    "linux"
    }
  }
}
EOF
    else
        rm -rf "${reg}"
    fi
}
register_arm64_proton 4628740 "Proton 11.0 (ARM64)" proton-11-arm64 proton11_arm64 "Proton 11.0 (ARM64)"
register_arm64_proton 4427310 "Proton Experimental (ARM64)" proton-experimental-arm64 proton_experimental_arm64 "Proton Experimental (ARM64)"

# The ARM client can't resolve require_tool_appid for the SLR4 Arm64 runtime (4185400)
# even when it's installed, so Protons requiring it fail "compat tool failed". Strip it
# from every Proton and run bare.
for manifest in "${steam_root}"/compatibilitytools.d/*/toolmanifest.vdf; do
    [[ -f "${manifest}" ]] || continue
    sed -i '/require_tool_appid.*4185400/d' "${manifest}"
done
for steamapps in "${steamapps_dirs[@]}"; do
    for manifest in "${steamapps}"/common/Proton*/toolmanifest.vdf; do
        [[ -f "${manifest}" ]] || continue
        sed -i '/require_tool_appid.*4185400/d' "${manifest}"
    done
done

touch "${steam_root}/.cef-enable-remote-debugging"
/usr/libexec/nebel/powerbuttond >/dev/null 2>&1 &
cd "${steam_arm_dir}"
exec "${steam_arm}" \
    "${steam_args[@]}" \
    "$@"
