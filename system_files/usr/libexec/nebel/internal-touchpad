#!/usr/bin/env python3
# Pass the internal touchscreen through a rotated uinput node.
#
# External-primary game mode: gamescope only lights up the external connector
# and (with the internal panel orientation forced back to normal) would map
# the raw internal digitizer rotated 90 degrees. This daemon grabs the raw
# device and re-emits every contact with the panel orientation applied, so
# consumers always see logical landscape coordinates. Two output nodes,
# selected by /etc/nebel/internal-touchpad.conf ENABLED= (default 0):
#
#   ENABLED=1  "Nebel Touchpad" - interim whole-panel pointer.
#     The InputPlumber Deck LeftPad/RightPad split (222a:0002) still drops
#     coordinates end to end, so until that chain is fixed the trackpad
#     mode re-emits the panel as a plain relative mouse: contact moves the
#     pointer with the button held (drag-style), which gamescope shows as
#     its regular cursor. Product 0x0004 keeps InputPlumber from claiming
#     the node.
#
#   ENABLED=0  "Nebel Rotated Touchscreen" - single-touch ABS + BTN_TOUCH.
#     gamescope consumes it directly: the internal panel keeps working as a
#     plain (correctly oriented) touchscreen. The toggle is a mode switch,
#     never a kill switch.
#
# Started/stopped by sessions.d/steam (external primary), nebel-control's
# set_internal_touchpad (live toggle), and stopped by desktop-bootstrap /
# the next internal-primary session. Pure stdlib on purpose: no
# python-evdev dependency in the image.
#
# Absolute rotation mirrors gamescope's own touchscreen transform
# (apply_touchscreen_orientation, panel native -> logical):
#   normal:      ( x,  y)        left (90):   (ymin+ymax-y, x)
#   right (270): ( y, xmin+xmax-x)  upsidedown: (xmin+xmax-x, ymin+ymax-y)
# Override with NEBEL_INTERNAL_TOUCHPAD_ROTATION if a device's digitizer
# axes don't match its panel orientation.
import fcntl
import os
import struct
import subprocess
import sys
from pathlib import Path

EV_SYN, EV_KEY, EV_ABS, EV_REL = 0x00, 0x01, 0x03, 0x02
SYN_REPORT = 0
BTN_TOUCH = 0x14A
BTN_LEFT = 0x110
REL_X, REL_Y = 0x00, 0x01
ABS_X, ABS_Y = 0x00, 0x01
ABS_MT_SLOT = 0x2F
ABS_MT_TRACKING_ID = 0x39
ABS_MT_POSITION_X = 0x35
ABS_MT_POSITION_Y = 0x36

INPUT_EVENT = struct.Struct("llHHi")
EVIOCGRAB = 0x40044590
EVIOCGABS = 0x80184540  # + axis, 6 ints
UI_SET_EVBIT = 0x40045564
UI_SET_KEYBIT = 0x40045565
UI_SET_RELBIT = 0x40045566
UI_SET_ABSBIT = 0x40045567
UI_ABS_SETUP = 0x401C5504  # struct uinput_abs_setup { u16 code; pad; 6 s32 }
UI_DEV_SETUP = 0x405C5503
UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502

VENDOR_NEBEL = 0x222A
PRODUCT_TRACKPAD_SCREEN = 0x0002
PRODUCT_ROTATED_TOUCHSCREEN = 0x0003
PRODUCT_TOUCHPAD = 0x0004
NAME_TRACKPAD_SCREEN = "Nebel Trackpad Screen"
NAME_ROTATED_TOUCHSCREEN = "Nebel Rotated Touchscreen"
NAME_TOUCHPAD = "Nebel Touchpad"

MODE_CONF = Path("/etc/nebel/internal-touchpad.conf")
DEBUG_TOUCH = os.environ.get("NEBEL_TOUCH_DEBUG") == "1"
_debug_last = 0.0


def debug_touch(point, tag):
    if not DEBUG_TOUCH:
        return
    import time
    global _debug_last
    now = time.monotonic()
    if now - _debug_last < 0.5:
        return
    _debug_last = now
    print(f"TOUCHDBG {tag} raw={point}", file=sys.stderr, flush=True)


def debug_line(text):
    if DEBUG_TOUCH:
        print(f"TOUCHDBG {text}", file=sys.stderr, flush=True)


def device_env():
    result = subprocess.check_output(["/usr/libexec/nebel/device-env"], text=True, timeout=5)
    env = {}
    for line in result.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        value = value.strip().strip("'").strip('"')
        # device-env prints systemd-escaped values ("generic\ ft5x06").
        env[key] = value.replace("\\ ", " ").replace("\\\\", "\\")
    return env


def find_touch_event(name_prefix):
    for input_dir in sorted(Path("/sys/class/input").glob("input*")):
        try:
            name = (input_dir / "name").read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if not name.startswith(name_prefix):
            continue
        for event in sorted(input_dir.glob("event*")):
            return Path("/dev/input") / event.name
    return None


def abs_info(fd, axis):
    values = struct.unpack("6i", fcntl.ioctl(fd, EVIOCGABS + axis, bytes(24)))
    return values[1], values[2]  # min, max


def read_mode():
    override = os.environ.get("NEBEL_INTERNAL_TOUCHPAD_MODE")
    if override in ("trackpad", "touchscreen"):
        return override
    # Default OFF (plain touchscreen): the Deck-trackpad split is opt-in
    # until the InputPlumber deck chain is confirmed working end to end.
    enabled = "0"
    try:
        for line in MODE_CONF.read_text(encoding="utf-8").splitlines():
            if line.startswith("ENABLED="):
                enabled = line.split("=", 1)[1].strip()
    except OSError:
        pass
    return "trackpad" if enabled != "0" else "touchscreen"


def rotate_point(orientation, x, y, x_range, y_range):
    if orientation == "left":
        return y_range[0] + y_range[1] - y, x
    if orientation == "right":
        return y, x_range[0] + x_range[1] - x
    if orientation == "upsidedown":
        return x_range[0] + x_range[1] - x, y_range[0] + y_range[1] - y
    if orientation == "mirrorx":
        # Digitizer native X runs right-to-left while Y runs top-to-bottom
        # (calibrated corner data on RP Mini V2's ft5x06): a pure horizontal
        # flip, no axis swap.
        return x_range[0] + x_range[1] - x, y
    return x, y


def rotate_delta(orientation, dx, dy):
    if orientation == "left":
        return -dy, dx
    if orientation == "right":
        return dy, -dx
    if orientation == "upsidedown":
        return -dx, -dy
    if orientation == "mirrorx":
        return -dx, dy
    return dx, dy


def output_ranges(orientation, x_range, y_range):
    # 90-degree rotations swap which physical axis feeds which logical one.
    if orientation in ("left", "right"):
        return y_range, x_range
    return x_range, y_range


def emit(fd, etype, code, value):
    os.write(fd, INPUT_EVENT.pack(0, 0, etype, code, value))


def open_uinput(name, product, abs_axes):
    # abs_axes: [(code, min, max), ...]
    fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_ABS)
    fcntl.ioctl(fd, UI_SET_KEYBIT, BTN_TOUCH)
    for code, minimum, maximum in abs_axes:
        fcntl.ioctl(fd, UI_SET_ABSBIT, code)
        setup = struct.pack("H2x6i", code, 0, minimum, maximum, 0, 0, 0)
        fcntl.ioctl(fd, UI_ABS_SETUP, setup)
    setup = (struct.pack("HHHH", 0x03, VENDOR_NEBEL, product, 1)
             + name.encode().ljust(80, b"\0") + struct.pack("I", 0))
    fcntl.ioctl(fd, UI_DEV_SETUP, setup)
    fcntl.ioctl(fd, UI_DEV_CREATE)
    return fd


def open_uinput_mouse(name, product):
    fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_REL)
    fcntl.ioctl(fd, UI_SET_KEYBIT, BTN_LEFT)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_SYN)
    fcntl.ioctl(fd, UI_SET_RELBIT, REL_X)
    fcntl.ioctl(fd, UI_SET_RELBIT, REL_Y)
    fcntl.ioctl(fd, UI_SET_RELBIT, 0x06)  # REL_HWHEEL
    fcntl.ioctl(fd, UI_SET_RELBIT, 0x08)  # REL_WHEEL
    fcntl.ioctl(fd, UI_SET_KEYBIT, 0x111)  # BTN_RIGHT
    setup = (struct.pack("HHHH", 0x03, VENDOR_NEBEL, product, 1)
             + name.encode().ljust(80, b"\0") + struct.pack("I", 0))
    fcntl.ioctl(fd, UI_DEV_SETUP, setup)
    fcntl.ioctl(fd, UI_DEV_CREATE)
    return fd


def read_events(fd):
    data = os.read(fd, INPUT_EVENT.size * 64)
    for off in range(0, len(data) - INPUT_EVENT.size + 1, INPUT_EVENT.size):
        yield INPUT_EVENT.unpack_from(data, off)


def run_trackpad(touch_fd, out_fd, orientation, x_range, y_range, max_slots):
    # Faithful MT pass-through: slot state is collected per frame and only
    # dirty slots are re-emitted (rotation swaps axes, so events cannot be
    # forwarded one by one). BTN_TOUCH mirrors "any contact" for consumers
    # that key off it instead of tracking ids.
    slot = 0
    slots = [None] * max_slots  # [x, y, tracking_id] per active slot
    dirty = set()
    new_tracking = {}
    touching = False

    def flush():
        nonlocal touching
        for s in sorted(dirty):
            emit(out_fd, EV_ABS, ABS_MT_SLOT, s)
            if s in new_tracking:
                emit(out_fd, EV_ABS, ABS_MT_TRACKING_ID, new_tracking[s])
            state = slots[s]
            if state is not None and state[0] is not None and state[1] is not None:
                x, y = rotate_point(orientation, state[0], state[1], x_range, y_range)
                emit(out_fd, EV_ABS, ABS_MT_POSITION_X, x)
                emit(out_fd, EV_ABS, ABS_MT_POSITION_Y, y)
        now_touching = any(state is not None for state in slots)
        if now_touching != touching:
            touching = now_touching
            emit(out_fd, EV_KEY, BTN_TOUCH, 1 if touching else 0)
        emit(out_fd, EV_SYN, SYN_REPORT, 0)
        dirty.clear()
        new_tracking.clear()

    while True:
        for _, _, etype, code, value in read_events(touch_fd):
            if etype == EV_ABS:
                if code == ABS_MT_SLOT:
                    slot = value
                elif code == ABS_MT_TRACKING_ID:
                    if 0 <= slot < max_slots:
                        slots[slot] = [None, None, value] if value >= 0 else None
                        dirty.add(slot)
                        new_tracking[slot] = value
                elif code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                    if 0 <= slot < max_slots and slots[slot] is not None:
                        slots[slot][0 if code == ABS_MT_POSITION_X else 1] = value
                        dirty.add(slot)
            elif etype == EV_SYN and code == SYN_REPORT:
                flush()


def run_touchpad(touch_fd, out_fd, orientation, x_range, y_range, max_slots):
    # Interim whole-panel pointer: one finger moves the pointer with the
    # left button held (drag-style), two fingers scroll (wheel) and a
    # two-finger tap right-clicks - the touchpad semantics the toggle UI
    # promises. Rotation is applied to deltas via rotate_delta; gains are
    # per raw axis, taken from the screen axis that axis ends up feeding.
    import time
    span_x = max(x_range[1] - x_range[0], 1)
    span_y = max(y_range[1] - y_range[0], 1)
    swapped = orientation in ("left", "right")
    scr_gain_x = 2200.0 / (span_y if swapped else span_x)
    scr_gain_y = 1400.0 / (span_x if swapped else span_y)
    raw_gain_x = scr_gain_y if swapped else scr_gain_x
    raw_gain_y = scr_gain_x if swapped else scr_gain_y
    slot = 0
    pos = {}  # slot -> [x, y]
    last = None
    last_multi = None
    multi_start = None
    multi_moved = 0.0
    scroll_acc = 0.0
    hscroll_acc = 0.0
    pressed = False
    acc_x = 0.0
    acc_y = 0.0

    def press(button, value):
        nonlocal pressed
        if pressed != value:
            pressed = value
            emit(out_fd, EV_KEY, button, 1 if value else 0)

    def click(button):
        emit(out_fd, EV_KEY, button, 1)
        emit(out_fd, EV_SYN, SYN_REPORT, 0)
        emit(out_fd, EV_KEY, button, 0)

    def mean_point(active):
        pts = [pos[s] for s in active if None not in pos.get(s, [None, None])]
        if not pts:
            return None
        return (sum(p[0] for p in pts) / len(pts),
                sum(p[1] for p in pts) / len(pts))

    while True:
        for _, _, etype, code, value in read_events(touch_fd):
            if etype == EV_ABS:
                if code == ABS_MT_SLOT:
                    slot = value
                elif code == ABS_MT_TRACKING_ID:
                    if value >= 0:
                        pos.setdefault(slot, [None, None])
                    else:
                        pos.pop(slot, None)
                        if slot == 0:
                            last = None
                elif code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                    if slot in pos:
                        pos[slot][0 if code == ABS_MT_POSITION_X else 1] = value
            elif etype == EV_SYN and code == SYN_REPORT:
                active = sorted(pos)
                if len(active) >= 2:
                    # Multi-contact: scroll + right-click tap, never drag.
                    press(BTN_LEFT, False)
                    last = None
                    point = mean_point(active)
                    if point is not None:
                        if last_multi is None:
                            last_multi = point
                            multi_start = time.monotonic()
                            multi_moved = 0.0
                        else:
                            mdx, mdy = rotate_delta(
                                orientation,
                                (point[0] - last_multi[0]) * raw_gain_x,
                                (point[1] - last_multi[1]) * raw_gain_y)
                            multi_moved += abs(mdx) + abs(mdy)
                            scroll_acc += mdy
                            hscroll_acc += mdx
                            last_multi = point
                    while scroll_acc <= -50:
                        scroll_acc += 50
                        emit(out_fd, EV_REL, 0x08, -1)  # REL_WHEEL up
                    while scroll_acc >= 50:
                        scroll_acc -= 50
                        emit(out_fd, EV_REL, 0x08, 1)   # REL_WHEEL down
                    while hscroll_acc <= -80:
                        hscroll_acc += 80
                        emit(out_fd, EV_REL, 0x06, -1)  # REL_HWHEEL left
                    while hscroll_acc >= 80:
                        hscroll_acc -= 80
                        emit(out_fd, EV_REL, 0x06, 1)   # REL_HWHEEL right
                    emit(out_fd, EV_SYN, SYN_REPORT, 0)
                    continue
                if last_multi is not None:
                    # End of a multi-contact gesture: short and still = right click.
                    if (multi_start is not None
                            and time.monotonic() - multi_start < 0.3
                            and multi_moved < 30):
                        click(0x111)  # BTN_RIGHT
                    last_multi = None
                    multi_start = None
                    scroll_acc = 0.0
                    hscroll_acc = 0.0
                if not active:
                    press(BTN_LEFT, False)
                    last = None
                    emit(out_fd, EV_SYN, SYN_REPORT, 0)
                    continue
                press(BTN_LEFT, True)
                point = pos[active[0]]
                if None not in point:
                    x, y = point
                    debug_touch((x, y), "touchpad")
                    if last is not None:
                        mdx, mdy = rotate_delta(
                            orientation, (x - last[0]) * raw_gain_x, (y - last[1]) * raw_gain_y)
                        acc_x += mdx
                        acc_y += mdy
                    last = (x, y)
                dx, dy = int(acc_x), int(acc_y)
                if dx or dy:
                    acc_x -= dx
                    acc_y -= dy
                    debug_line(f"rel ori={orientation} dx={dx} dy={dy}")
                    emit(out_fd, EV_REL, REL_X, dx)
                    emit(out_fd, EV_REL, REL_Y, dy)
                emit(out_fd, EV_SYN, SYN_REPORT, 0)


def run_touchscreen(touch_fd, out_fd, orientation, x_range, y_range, max_slots):
    # Single-touch reconstruction of the primary (first) contact.
    slot = 0
    slots = {}  # slot -> [x, y]
    touching = False

    while True:
        for _, _, etype, code, value in read_events(touch_fd):
            if etype == EV_ABS:
                if code == ABS_MT_SLOT:
                    slot = value
                elif code == ABS_MT_TRACKING_ID:
                    if value >= 0:
                        slots.setdefault(slot, [None, None])
                    else:
                        slots.pop(slot, None)
                elif code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                    if slot in slots:
                        slots[slot][0 if code == ABS_MT_POSITION_X else 1] = value
            elif etype == EV_SYN and code == SYN_REPORT:
                active = sorted(slots)
                if active and not touching:
                    touching = True
                    emit(out_fd, EV_KEY, BTN_TOUCH, 1)
                elif not active and touching:
                    touching = False
                    emit(out_fd, EV_KEY, BTN_TOUCH, 0)
                if active:
                    x, y = slots[active[0]]
                    if x is not None and y is not None:
                        debug_touch((x, y), "touchscreen")
                        rx, ry = rotate_point(orientation, x, y, x_range, y_range)
                        emit(out_fd, EV_ABS, ABS_X, rx)
                        emit(out_fd, EV_ABS, ABS_Y, ry)
                emit(out_fd, EV_SYN, SYN_REPORT, 0)


def main():
    env = device_env()
    name_prefix = env.get("NEBEL_INTERNAL_TOUCHSCREEN", "")
    if not name_prefix:
        sys.exit("NEBEL_INTERNAL_TOUCHSCREEN is not set for this device")
    orientation = os.environ.get(
        "NEBEL_INTERNAL_TOUCHPAD_ROTATION",
        env.get("NEBEL_PANEL_ORIENTATION", "normal"))
    mode = read_mode()
    debug_line(f"start mode={mode} orientation={orientation}")

    node = find_touch_event(name_prefix)
    if node is None:
        sys.exit(f"touchscreen '{name_prefix}*' not found")

    touch_fd = os.open(node, os.O_RDONLY)
    fcntl.ioctl(touch_fd, EVIOCGRAB, 1)
    # Ranges come from the MT axes; some digitizers don't expose the
    # single-touch ABS_X/ABS_Y emulation.
    x_range = abs_info(touch_fd, ABS_MT_POSITION_X)
    y_range = abs_info(touch_fd, ABS_MT_POSITION_Y)
    if x_range[1] <= x_range[0]:
        x_range = abs_info(touch_fd, ABS_X)
    if y_range[1] <= y_range[0]:
        y_range = abs_info(touch_fd, ABS_Y)
    slot_range = abs_info(touch_fd, ABS_MT_SLOT)
    max_slots = max(slot_range[1] + 1, 1)
    out_x_range, out_y_range = output_ranges(orientation, x_range, y_range)

    if mode == "trackpad":
        out_fd = open_uinput_mouse(NAME_TOUCHPAD, PRODUCT_TOUCHPAD)
        runner = run_touchpad
    else:
        abs_axes = [(ABS_X, out_x_range[0], out_x_range[1]),
                    (ABS_Y, out_y_range[0], out_y_range[1])]
        out_fd = open_uinput(NAME_ROTATED_TOUCHSCREEN, PRODUCT_ROTATED_TOUCHSCREEN, abs_axes)
        runner = run_touchscreen

    try:
        runner(touch_fd, out_fd, orientation, x_range, y_range, max_slots)
    finally:
        fcntl.ioctl(out_fd, UI_DEV_DESTROY)
        os.close(out_fd)
        os.close(touch_fd)


if __name__ == "__main__":
    main()
