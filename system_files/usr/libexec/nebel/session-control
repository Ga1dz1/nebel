#!/usr/bin/bash
# zz- sorts after nebel.conf so its Session= wins (User=/Relogin= stay there).
set -euo pipefail

case "${1:-}" in
    switch-desktop)  session=nebel-plasma.desktop ;;
    switch-gamemode) session=gamescope-session-steam.desktop ;;
    switch-dualscreen) session=nebel-dualscreen.desktop ;;
    default-gamemode) session=gamescope-session-steam.desktop; default_only=1 ;;
    *) echo "usage: $0 {switch-desktop|switch-gamemode|switch-dualscreen|default-gamemode}" >&2; exit 1 ;;
esac

SERVICE='org.shadowblip.InputPlumber'
IFACE='org.shadowblip.Input.CompositeDevice'
# Profiles that support mouse/keyboard emulation in desktop mode.
NEBEL_PROFILE_NAMES=(
    'AYANEO Japanese Layout'
    'AYANEO Layout'
    'AYANEO Standard Layout'
    'AYN Layout'
    'Retroid Layout'
)

inputplumber_paths() {
    busctl --system tree "$SERVICE" 2>/dev/null \
        | grep -oE '/org/shadowblip/InputPlumber/CompositeDevice[0-9]+' \
        | sort -u
}

inputplumber_composite_name() {
    local path=$1
    busctl --system get-property "$SERVICE" "$path" "$IFACE" Name 2>/dev/null \
        | sed 's/.*"\([^"]*\)".*/\1/'
}

inputplumber_set_targets() {
    local paths
    paths=$(inputplumber_paths)
    [[ -n "$paths" ]] || return 0
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        local name
        name=$(inputplumber_composite_name "$path")
        local match=0
        for profile in "${NEBEL_PROFILE_NAMES[@]}"; do
            if [[ "$name" == "$profile" ]]; then
                match=1
                break
            fi
        done
        [[ "$match" == 1 ]] || continue
        busctl --system call "$SERVICE" "$path" "$IFACE" SetTargetDevices as \
            "$#" "$@" >/dev/null 2>&1 || true
    done <<< "$paths"
}

inputplumber_desktop_mode() {
    # In Plasma desktop mode the handheld gamepad needs to emulate a mouse
    # and keyboard so the user can navigate without a paired Bluetooth
    # keyboard/mouse. The xb360 gamepad target stays up alongside them: while
    # the mouse_keyboard profile is loaded it swallows the events anyway, and
    # desktop-input-mode can flip the profile to default.yaml on the fly so
    # SDL games/emulators (Azahar etc.) see a real controller.
    inputplumber_set_targets xb360 mouse keyboard
}

inputplumber_gamepad_mode() {
    # Restore the controller type selected by the user (deck-uhid, xb360, ds5).
    /usr/libexec/nebel/controller-type apply >/dev/null 2>&1 || true
}

logout_plasma() {
    local user=nebel
    local uid=1000
    local bus="/run/user/${uid}/bus"
    local qdbus=

    [[ -S "${bus}" ]] || return 1

    for candidate in qdbus-qt6 qdbus6 qdbus /usr/lib64/qt6/bin/qdbus; do
        if command -v "${candidate}" >/dev/null 2>&1; then
            qdbus=$(command -v "${candidate}")
            break
        elif [[ -x "${candidate}" ]]; then
            qdbus="${candidate}"
            break
        fi
    done

    [[ -n "${qdbus}" ]] || return 1

    sudo -Eu "${user}" env \
        XDG_RUNTIME_DIR="/run/user/${uid}" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}" \
        "${qdbus}" org.kde.Shutdown /Shutdown org.kde.Shutdown.logout
}

printf '[Autologin]\nSession=%s\n' "${session}" > /etc/sddm.conf.d/zz-steamos-autologin.conf
systemctl reset-failed sddm.service 2>/dev/null || true

if [[ "${default_only:-0}" == "1" ]]; then
    exit 0
fi

case "${1:-}" in
    switch-desktop)
        inputplumber_desktop_mode
        ;;
    switch-gamemode|switch-dualscreen)
        inputplumber_gamepad_mode
        ;;
esac

if [[ ${1:-} == "switch-gamemode" ]] && logout_plasma; then
    exit 0
fi

systemctl --no-block restart sddm.service
