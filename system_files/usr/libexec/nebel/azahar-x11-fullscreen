#!/usr/bin/env python3
# Fullscreens Azahar's X11 windows in the dual-screen session.
#
# labwc window rules place the windows on their outputs at first map, but
# Azahar then re-applies its saved Qt window state, which silently reverts
# a compositor-forced fullscreen. Pressing F11 by hand works fine - this
# watcher does the same thing programmatically: it polls the X11 client
# list and sends every Azahar window a _NET_WM_STATE_FULLSCREEN "add"
# client message until it sticks. Pure ctypes + libX11: no python-xlib in
# the image.
import ctypes
import os
import sys
import time
from ctypes import POINTER, byref, c_char_p, c_int, c_long, c_ulong, c_void_p

WATCH_SECONDS = 180
XA_ATOM = 4
XA_WM_CLASS = 67
SUBSTRUCTURE_MASK = (1 << 19) | (1 << 20)  # Notify | Redirect


class XClientMessageData(ctypes.Union):
    _fields_ = [("b", ctypes.c_char * 20), ("s", ctypes.c_short * 10), ("l", c_long * 5)]


class XClientMessageEvent(ctypes.Structure):
    _fields_ = [("type", c_int), ("serial", c_ulong), ("send_event", c_int),
                ("display", c_void_p), ("window", c_ulong),
                ("message_type", c_ulong), ("format", c_int),
                ("data", XClientMessageData)]


class XEvent(ctypes.Union):
    _fields_ = [("type", c_int), ("xclient", XClientMessageEvent), ("pad", c_long * 24)]


lib = ctypes.CDLL("libX11.so.6")
lib.XOpenDisplay.restype = c_void_p
lib.XOpenDisplay.argtypes = [c_char_p]
lib.XDefaultRootWindow.restype = c_ulong
lib.XDefaultRootWindow.argtypes = [c_void_p]
lib.XInternAtom.restype = c_ulong
lib.XInternAtom.argtypes = [c_void_p, c_char_p, c_int]
lib.XGetWindowProperty.restype = c_int
lib.XGetWindowProperty.argtypes = [c_void_p, c_ulong, c_ulong, c_long, c_long, c_int,
                                   c_ulong, POINTER(c_ulong), POINTER(c_int),
                                   POINTER(c_ulong), POINTER(c_ulong), POINTER(c_void_p)]
lib.XSendEvent.restype = c_int
lib.XSendEvent.argtypes = [c_void_p, c_ulong, c_int, c_long, POINTER(XEvent)]
lib.XFlush.argtypes = [c_void_p]
lib.XFree.argtypes = [c_void_p]


def get_prop(dpy, win, prop, req_type):
    actual_type = c_ulong()
    actual_format = c_int()
    nitems = c_ulong()
    bytes_after = c_ulong()
    data = c_void_p()
    ok = lib.XGetWindowProperty(dpy, win, prop, 0, 1024, 0, req_type,
                                byref(actual_type), byref(actual_format),
                                byref(nitems), byref(bytes_after), byref(data))
    if ok != 0 or not data:
        return None, 0
    return data, nitems.value


def main():
    dpy = None
    deadline = time.monotonic() + WATCH_SECONDS
    while time.monotonic() < deadline:
        if dpy is None:
            dpy = lib.XOpenDisplay(os.environ.get("DISPLAY", ":0").encode())
            if not dpy:
                time.sleep(1)
                continue
        root = lib.XDefaultRootWindow(dpy)
        client_list = lib.XInternAtom(dpy, b"_NET_CLIENT_LIST", 1)
        wm_state = lib.XInternAtom(dpy, b"_NET_WM_STATE", 1)
        wm_state_fs = lib.XInternAtom(dpy, b"_NET_WM_STATE_FULLSCREEN", 1)
        wm_state_msg = lib.XInternAtom(dpy, b"_NET_WM_STATE", 1)

        data, nitems = get_prop(dpy, root, client_list, 33)  # XA_WINDOW=33
        if data:
            windows = ctypes.cast(data.value, POINTER(c_ulong))
            for i in range(nitems):
                win = windows[i]
                cls_data, cls_len = get_prop(dpy, win, XA_WM_CLASS, 0)
                if not cls_data:
                    continue
                cls = ctypes.string_at(cls_data.value, cls_len).lower()
                lib.XFree(cls_data)
                if b"azahar" not in cls:
                    continue
                state_data, state_len = get_prop(dpy, win, wm_state, XA_ATOM)
                states = []
                if state_data:
                    atoms = ctypes.cast(state_data.value, POINTER(c_ulong))
                    states = [atoms[j] for j in range(state_len)]
                    lib.XFree(state_data)
                if wm_state_fs in states:
                    continue
                event = XEvent()
                event.xclient.type = 33  # ClientMessage
                event.xclient.display = dpy
                event.xclient.window = win
                event.xclient.message_type = wm_state_msg
                event.xclient.format = 32
                event.xclient.data.l[0] = 1  # _NET_WM_STATE_ADD
                event.xclient.data.l[1] = wm_state_fs
                event.xclient.data.l[2] = 0
                event.xclient.data.l[3] = 2  # normal application source
                lib.XSendEvent(dpy, root, 0, SUBSTRUCTURE_MASK, byref(event))
            lib.XFree(data)
            lib.XFlush(dpy)
        time.sleep(2)
    return 0


if __name__ == "__main__":
    sys.exit(main())
