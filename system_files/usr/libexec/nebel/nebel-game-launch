#!/usr/bin/env python3
# Game launch-option prefix wrapper ("nebel-game-launch %command%"). Applies
# per-game settings via FEX_APP_CONFIG, the only knob every compat tool's FEX reads
# (the on-disk FEX config files are seen only by the system FEX, not arm64ec/wow64).
# Also patches the Wine prefix registry (Windows version, virtual desktop,
# WineD3D GPU identity), sets renderer/memory env and CPU affinity for old games.
import json
import os
import pathlib
import resource
import shutil
import sys
import time


BASE_FEX_CONFIG = pathlib.Path("/usr/share/fex-emu/Config.json")
TWEAKS_CONFIG = pathlib.Path("/etc/nebel/game-tweaks.json")
FEX_PROFILES_CONFIG = pathlib.Path("/usr/share/nebel/fex-profiles.json")
PROTON_INJECT_SRC = pathlib.Path("/usr/share/nebel/proton-inject/x86_64-linux-gnu")


def appid():
    for key in ("STEAM_COMPAT_APP_ID", "SteamAppId", "SteamGameId"):
        value = os.environ.get(key, "").strip()
        if value.isdigit():
            return value
    return None


def load_fex_contract():
    with FEX_PROFILES_CONFIG.open(encoding="utf-8") as f:
        contract = json.load(f)
    profiles = contract.get("profiles")
    if not isinstance(contract.get("defaults"), dict) or not isinstance(profiles, dict) or "default" not in profiles:
        raise ValueError("invalid FEX profile contract")
    for profile in profiles.values():
        if not isinstance(profile, dict) or not isinstance(profile.get("config"), dict):
            raise ValueError("invalid FEX profile contract")
    return contract


def load_tweaks(defaults):
    data = json.loads(json.dumps(defaults))
    try:
        with TWEAKS_CONFIG.open(encoding="utf-8") as f:
            loaded = json.load(f)
    except (OSError, ValueError):
        return data
    if not isinstance(loaded, dict):
        return data
    if isinstance(loaded.get("global"), dict):
        data["global"].update(loaded["global"])
    if isinstance(loaded.get("games"), dict):
        data["games"] = loaded["games"]
    return data


def merged_settings(tweaks, game_id):
    settings = dict(tweaks.get("global", {}))
    if game_id:
        game_settings = tweaks.get("games", {}).get(str(game_id))
        # Legacy configs may carry enabled: false; skip those, apply the rest.
        if isinstance(game_settings, dict) and game_settings.get("enabled") is not False:
            settings.update(game_settings)
    return settings


def thunk_settings(settings, modules):
    thunks = settings.get("thunks")
    if not isinstance(thunks, dict):
        thunks = {}
    return {name: 1 if thunks.get(name, True) else 0 for name in modules}


# SM8250's cpu0-3 are the 1.8GHz LITTLE cluster, cpu4-7 the 2.4-2.84GHz
# big+prime cluster (confirmed via cpuinfo_max_freq) - same split ROCKNIX's
# own SM8250 quirk profile uses (SLOW_CORES="taskset -c 0-3", FAST_CORES=
# "taskset -c 4-7"). "big" pins emulation-heavy work off the slow cluster
# entirely instead of leaving the scheduler free to place it anywhere.
# "one"/"two" cap core *count* on the fast cluster: old games break from
# too many threads (race conditions, timing loops calibrated for 1-2 cores).
CORE_SETS = {
    "little": {0, 1, 2, 3},
    "big": {4, 5, 6, 7},
    "one": {4},
    "two": {4, 5},
}


def legacy_era(settings):
    return settings.get("gameEra") or ""


def apply_cpu_affinity(settings):
    cores = settings.get("cores")
    if not cores and legacy_era(settings) == "xp":
        cores = "two"  # era preset: old engines break on 8 threads
    core_set = CORE_SETS.get(cores)
    if not core_set:
        return
    os.sched_setaffinity(0, core_set)


def runtime_config_dir():
    # pressure-vessel gives the container a private /tmp and only bind-mounts
    # selected paths, so a config meant for FEX inside the container must live
    # somewhere that is guaranteed to be mounted: the compatdata dir. XDG
    # runtime dir is NOT mounted there (nor is /tmp).
    data_path = os.environ.get("STEAM_COMPAT_DATA_PATH")
    if data_path:
        return pathlib.Path(data_path) / "nebel-fex"
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return pathlib.Path(runtime) / "nebel-fex"
    return pathlib.Path("/tmp") / f"nebel-fex-{os.getuid()}"


# FEX inside pressure-vessel sees the container's own /usr, so absolute /usr
# paths in the config (RootFS, thunk dirs) are dead ends there; the host fs is
# reachable under /run/host instead. Non-container launches keep host paths.
CONTAINER_PATH_KEYS = ("RootFS", "ThunkGuestLibs", "ThunkHostLibs")


def containerize_config_paths(config):
    cfg = config.get("Config", {})
    for key in CONTAINER_PATH_KEYS:
        value = cfg.get(key)
        if isinstance(value, str) and value.startswith("/usr/"):
            cfg[key] = "/run/host" + value


def resolve_fex_config(settings, profiles):
    profile_id = settings.get("fexProfile")
    if isinstance(profile_id, str) and profile_id in profiles:
        return profiles[profile_id]["config"]
    fex_config = settings.get("fexConfig")
    if isinstance(fex_config, dict):
        return fex_config
    return profiles["default"]["config"]


def apply_fex(settings, game_id, profiles, env):
    with BASE_FEX_CONFIG.open(encoding="utf-8") as f:
        config = json.load(f)
    allowed = set().union(*(profile["config"].keys() for profile in profiles.values()))
    fex_config = resolve_fex_config(settings, profiles)
    config.setdefault("Config", {}).update({k: v for k, v in fex_config.items() if k in allowed})
    config["ThunksDB"] = thunk_settings(settings, config.get("ThunksDB", {}).keys())
    if os.environ.get("STEAM_COMPAT_DATA_PATH"):
        containerize_config_paths(config)

    config_dir = runtime_config_dir()
    config_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    cutoff = time.time() - 86400
    for old in config_dir.glob("*.json"):
        try:
            if old.stat().st_mtime < cutoff:
                old.unlink()
        except OSError:
            pass
    name = f"{game_id or 'global'}.{os.getpid()}.json"
    target = config_dir / name
    tmp = target.with_name(f".{name}.tmp")
    try:
        with tmp.open("w", encoding="utf-8") as f:
            json.dump(config, f, indent=2, sort_keys=True)
            f.write("\n")
        os.replace(tmp, target)
        env["FEX_APP_CONFIG"] = str(target)
    finally:
        tmp.unlink(missing_ok=True)


def inject_x86_protocol_libs():
    # pressure-vessel doesn't provide the x86 libwayland-client/libxkbcommon the game
    # needs, so it can't load them (dead controller). Remove once pressure-vessel supplies
    # them.
    if not PROTON_INJECT_SRC.is_dir():
        return
    for tool in os.environ.get("STEAM_COMPAT_TOOL_PATHS", "").split(":"):
        files = pathlib.Path(tool) / "files" if tool else None
        if files is None:
            continue
        lib_dir = files / "lib" / "x86_64-linux-gnu"
        if not lib_dir.is_dir() or (files / "bin-arm64").is_dir():  # skip arm64ec Proton
            continue
        # link targets must be copied before the symlinks that point at them
        for src in sorted(PROTON_INJECT_SRC.iterdir(), key=pathlib.Path.is_symlink):
            dest = lib_dir / src.name
            if dest.exists() or dest.is_symlink():
                continue
            if src.is_symlink():
                os.symlink(os.readlink(src), dest)
            else:
                shutil.copy2(src, dest)


def repair_wedged_controller():
    # x86 Proton can leave the pad registered as a bare USB device, never promoted to
    # WINEXINPUT (dead under x86 too); an arm64ec Proton reusing that prefix then can't
    # re-register it - winebus hits "already exists" (plugplay 0xe000020b) - and inherits
    # the dead pad. Drop the stale VID_28DE sections to re-register.
    data_path = os.environ.get("STEAM_COMPAT_DATA_PATH")
    if not data_path:
        return
    reg = pathlib.Path(data_path) / "pfx" / "system.reg"
    try:
        text = reg.read_text(encoding="utf-8", errors="surrogateescape")
    except FileNotFoundError:
        return
    lines = text.splitlines(keepends=True)
    pad_sections = sum(1 for line in lines if line.startswith("[") and "VID_28DE" in line)
    # Only a WINEXINPUT key for this same pad proves promotion; an old target's keys outlive it.
    promoted = any("WINEXINPUT" in line and "VID_28DE" in line for line in lines)
    if not pad_sections or promoted:
        return  # no pad registered, or it promoted fine - leave the prefix alone
    reg.with_name("system.reg.nebel-bak").write_text(
        text, encoding="utf-8", errors="surrogateescape")
    kept, skip = [], False
    for line in lines:
        if line.startswith("["):
            skip = "VID_28DE" in line
        if not skip:
            kept.append(line)
    tmp = reg.with_name(".system.reg.nebel-tmp")
    tmp.write_text("".join(kept), encoding="utf-8", errors="surrogateescape")
    os.replace(tmp, reg)
    print(f"nebel-game-launch: cleared wedged controller state "
          f"({pad_sections} pad sections)", file=sys.stderr)


# --- Old games: legacy Windows version, renderer, memory, GPU spoof ------

# Wine's own version switch: ntdll answers RtlGetVersion from HKCU\Software\Wine
# "Version" (what most games query), the HKLM NT values cover games that read
# the registry directly. Key layout verified against a live Proton prefix
# (system.reg/user.reg under steamapps/compatdata/<appid>/pfx).
XP_NT_CURRENT_VERSION = {
    "CurrentVersion": '"5.1"',
    "ProductName": '"Microsoft Windows XP"',
    "CurrentBuild": '"2600"',
    "CurrentBuildNumber": '"2600"',
    "CSDVersion": '"Service Pack 3"',
    "CurrentMajorVersionNumber": "dword:00000005",
    "CurrentMinorVersionNumber": "dword:00000001",
}

# (PCI vendor, PCI device, DXGI/wined3d-reported name). Steam Deck's VanGogh
# is what Proton-on-Deck titles expect; NVIDIA/AMD presets satisfy games that
# refuse to run on an unrecognized GPU.
GPU_SPOOFS = {
    "steamdeck": (0x1002, 0x163F, "AMD Custom GPU 0405 (RADV VANGOGH)"),
    "gtx1060": (0x10DE, 0x1C03, "NVIDIA GeForce GTX 1060 6GB"),
    "rx580": (0x1002, 0x67DF, "Radeon RX 580 Series"),
}

REG_STATE_NAME = ".nebel-registry-state.json"


def windows_version_setting(settings):
    value = settings.get("windowsVersion") or "auto"
    if value == "auto":
        return "winxp" if legacy_era(settings) == "xp" else "default"
    return value


def use_wined3d(settings):
    value = settings.get("legacyRenderer") or "auto"
    if value == "auto":
        value = "on" if legacy_era(settings) == "xp" else "off"
    return value == "on"


def apply_renderer(settings, env):
    explicit = settings.get("legacyRenderer") or "auto"
    if use_wined3d(settings):
        # DXVK covers D3D8-12; D3D1-7 (ddraw-era) renders wrong or not at all
        # through it, so XP-era titles get WineD3D for everything.
        env["PROTON_USE_WINED3D"] = "1"
    elif explicit == "off":
        env.pop("PROTON_USE_WINED3D", None)


def apply_gpu_spoof(settings, env, wined3d):
    spoof = GPU_SPOOFS.get(settings.get("gpuSpoof") or "")
    if not spoof or wined3d or env.get("DXVK_CONFIG_FILE"):
        return  # wined3d spoofs via the registry; a user config file wins
    vendor, device, name = spoof
    text = (f"dxvk.customVendorId = {vendor:x}\n"
            f"dxvk.customDeviceId = {device:x}\n"
            f"dxvk.customDeviceName = {name}\n")
    # DXVK reads this inside pressure-vessel, so prefer the compatdata dir -
    # it is bind-mounted into the container, XDG_RUNTIME_DIR is not.
    data_path = os.environ.get("STEAM_COMPAT_DATA_PATH")
    target_dir = pathlib.Path(data_path) if data_path else runtime_config_dir()
    try:
        target_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        target = target_dir / "nebel-dxvk.conf"
        target.write_text(text, encoding="utf-8")
        env["DXVK_CONFIG_FILE"] = str(target)
    except OSError as exc:
        print(f"nebel-game-launch: GPU spoof skipped: {exc}", file=sys.stderr)


# --- Per-game DXVK/VKD3D-Proton version overrides ---------------------------

# nebel-control's "DXVK version"/"D3D12 (VKD3D) version" pickers: current
# DXVK/VKD3D releases demand Vulkan features Turnip never exposes on Adreno
# 6xx, so the image carries older/community builds under /usr/share/nebel and
# the chosen build's dlls are copied into the game's prefix. "" (default)
# keeps whatever Proton ships.
GFX_LAYER_ROOT = {
    "dxvk": pathlib.Path("/usr/share/nebel/dxvk"),
    "vkd3d": pathlib.Path("/usr/share/nebel/vkd3d"),
}
GFX_STATE_NAME = ".nebel-gfx-override.json"
GFX_ARCHES = (("x64", "system32"), ("x32", "syswow64"))


def stock_gfx_dirs(kind):
    """The compat tool's bundled dxvk/vkd3d dll dirs, as {"x64": ..., "x32": ...}.

    Rollback source for overrides - copying these back restores exactly what
    Proton shipped, so no in-prefix dll backups are kept. Layout differs
    between Proton builds, so glob for the dir name under each libdir.
    """
    dirname = "dxvk" if kind == "dxvk" else "vkd3d-proton"
    found = {}
    for tool in os.environ.get("STEAM_COMPAT_TOOL_PATHS", "").split(":"):
        files = pathlib.Path(tool) / "files" if tool else None
        if files is None or not files.is_dir():
            continue
        for arch, libdir in (("x64", "lib64"), ("x32", "lib")):
            if arch in found:
                continue
            candidate = files / libdir / "wine" / dirname
            if not candidate.is_dir():
                matches = sorted(files.glob(f"{libdir}/wine/**/{dirname}"))
                candidate = matches[0] if matches else candidate
            if candidate.is_dir():
                found[arch] = candidate
    return found


def install_gfx_dlls(pfx, kind, sources, previous):
    """Copy each arch's dlls into the prefix, dropping dlls only the previous
    set carried. Missing individual dlls warn and the rest still installs."""
    for arch, dest_name in GFX_ARCHES:
        src = sources.get(arch)
        dest = pfx / "drive_c" / "windows" / dest_name
        if src is None or not src.is_dir():
            print(f"nebel-game-launch: no {kind} {arch} dll source, skipping {dest_name}",
                  file=sys.stderr)
            continue
        if not dest.is_dir():
            print(f"nebel-game-launch: {dest} missing, skipping {kind} {arch}",
                  file=sys.stderr)
            continue
        keep = {dll.name for dll in src.glob("*.dll")}
        prev = (previous or {}).get(arch)
        if prev is not None and prev.is_dir():
            for old in prev.glob("*.dll"):
                if old.name not in keep:
                    (dest / old.name).unlink(missing_ok=True)
        for dll in sorted(src.glob("*.dll")):
            try:
                shutil.copy2(dll, dest / dll.name)
            except OSError as exc:
                print(f"nebel-game-launch: failed to install {dll.name}: {exc}",
                      file=sys.stderr)


def apply_dxvk_override(pfx, settings):
    """Install/revert per-game DXVK/VKD3D-Proton dll overrides in the prefix.

    <pfx>/.nebel-gfx-override.json records {"dxvk": id|null, "vkd3d": id|null};
    when the setting differs from the recorded state the selected build's dlls
    are copied in (a version switch just copies the new build over), and going
    back to default restores the compat tool's stock dlls.
    """
    state_path = pfx / GFX_STATE_NAME
    try:
        prior = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        prior = {}
    if not isinstance(prior, dict):
        prior = {}
    new_state = {}
    for kind, key in (("dxvk", "dxvkVersion"), ("vkd3d", "vkd3dVersion")):
        wanted = settings.get(key)
        wanted = wanted if isinstance(wanted, str) else ""
        recorded = prior.get(kind)
        recorded = recorded if isinstance(recorded, str) else ""
        if wanted == recorded:
            if wanted:
                new_state[kind] = wanted
            continue
        previous = None
        if recorded:
            prev_root = GFX_LAYER_ROOT[kind] / recorded
            previous = {arch: prev_root / arch for arch, _ in GFX_ARCHES}
        if wanted:
            root = GFX_LAYER_ROOT[kind] / wanted
            if not root.is_dir():
                print(f"nebel-game-launch: {kind} build '{wanted}' is not in this "
                      f"OS image, keeping previous", file=sys.stderr)
                if recorded:
                    new_state[kind] = recorded
                continue
            sources = {arch: root / arch for arch, _ in GFX_ARCHES}
        else:
            sources = stock_gfx_dirs(kind)
            if not sources:
                print(f"nebel-game-launch: stock {kind} dlls not found in the "
                      f"compat tool, leaving override in place", file=sys.stderr)
                if recorded:
                    new_state[kind] = recorded
                continue
        install_gfx_dlls(pfx, kind, sources, previous)
        if wanted:
            new_state[kind] = wanted
    if new_state:
        state_path.write_text(json.dumps(new_state, indent=2, sort_keys=True) + "\n",
                              encoding="utf-8")
    else:
        state_path.unlink(missing_ok=True)


def apply_memory_limit(settings):
    try:
        mb = int(settings.get("memoryLimitMB") or 0)
    except (TypeError, ValueError):
        return
    if mb <= 0:
        return
    # Wine has no knob for *reported* RAM (GlobalMemoryStatusEx comes straight
    # from sysinfo(2)), so this caps the address space instead: old games that
    # crash on >2GB reported RAM usually also misbehave allocating past their
    # expectations. RLIMIT_AS counts virtual reservations - FEX/DXVK map many
    # GB up front, so small limits can break modern titles; last-resort knob.
    limit = mb * 1024 * 1024
    resource.setrlimit(resource.RLIMIT_AS, (limit, limit))


def pfx_dir():
    data_path = os.environ.get("STEAM_COMPAT_DATA_PATH")
    if not data_path:
        return None
    pfx = pathlib.Path(data_path) / "pfx"
    return pfx if pfx.is_dir() else None


def managed_registry_entries(settings, wined3d):
    # (reg file, section, value name, desired text, create missing section)
    entries = []
    if windows_version_setting(settings) == "winxp":
        nt = r"Software\\Microsoft\\Windows NT\\CurrentVersion"
        for name, value in XP_NT_CURRENT_VERSION.items():
            entries.append(("system.reg", nt, name, value, False))
        # 0x300 = Service Pack 3; Proton reg files carry ControlSet001 only,
        # but patch any control set that happens to exist.
        for cs in ("ControlSet001", "ControlSet002"):
            entries.append(("system.reg", rf"System\\{cs}\\Control\\Windows",
                            "CSDVersion", "dword:00000300", False))
        entries.append(("user.reg", r"Software\\Wine", "Version", '"winxp"', True))
    desktop = settings.get("virtualDesktop") or ""
    if desktop:
        entries.append(("user.reg", r"Software\\Wine\\Explorer", "Desktop", '"Default"', True))
        entries.append(("user.reg", r"Software\\Wine\\Explorer\\Desktops",
                        "Default", f'"{desktop}"', True))
    spoof = GPU_SPOOFS.get(settings.get("gpuSpoof") or "")
    if spoof and wined3d:
        vendor, device, _name = spoof
        entries.append(("user.reg", r"Software\\Wine\\Direct3D",
                        "VideoPciVendorID", f"dword:{vendor:08x}", True))
        entries.append(("user.reg", r"Software\\Wine\\Direct3D",
                        "VideoPciDeviceID", f"dword:{device:08x}", True))
    return entries


def section_ranges(lines):
    ranges = []
    start = None
    for i, line in enumerate(lines):
        if line.startswith("["):
            if start is not None:
                ranges.append((start, i))
            start = i
    if start is not None:
        ranges.append((start, len(lines)))
    return ranges


def find_section(lines, name):
    # header lines carry a trailing write timestamp: "[Software\\Wine] 1787473732"
    for start, end in section_ranges(lines):
        header = lines[start]
        if header.startswith("[") and header[1:].split("]", 1)[0] == name:
            return start, end
    return None


def sync_registry(pfx, settings, wined3d):
    """Apply/revert managed registry values, keeping originals for rollback.

    Every value we touch is recorded in <pfx>/.nebel-registry-state.json with
    its previous line; when a setting goes back to default the next launch
    restores the original text (or removes values/sections we created).
    """
    state_path = pfx / REG_STATE_NAME
    try:
        prior = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        prior = {}
    wanted = {}
    for reg_file, section, name, value, create in managed_registry_entries(settings, wined3d):
        wanted.setdefault(reg_file, []).append((section, name, value, create))
    new_state = {}
    for reg_file in sorted(set(wanted) | set(prior)):
        path = pfx / reg_file
        try:
            text = path.read_text(encoding="utf-8", errors="surrogateescape")
        except FileNotFoundError:
            continue
        eol = "\r\n" if "\r\n" in text else "\n"
        lines = text.splitlines()
        old = prior.get(reg_file, {})
        changed = False
        # 1) roll back whatever a previous launch managed
        for entry in old.get("entries", []):
            if revert_reg_value(lines, entry):
                changed = True
        for section in old.get("created", []):
            if drop_empty_section(lines, section):
                changed = True
        # 2) apply the currently wanted values
        applied, created = [], []
        for section, name, value, create in wanted.get(reg_file, []):
            result = apply_reg_value(lines, section, name, value, create)
            if result is None:
                continue
            entry, did_change, did_create = result
            applied.append(entry)
            changed = changed or did_change
            if did_create:
                created.append(section)
        if not changed:
            if applied or created:
                new_state[reg_file] = {"entries": applied, "created": created}
            continue
        backup = path.with_name(path.name + ".nebel-bak")
        if not backup.exists():
            try:
                backup.write_text(text, encoding="utf-8", errors="surrogateescape")
            except OSError:
                pass
        tmp = path.with_name(f".{path.name}.nebel-tmp")
        tmp.write_text(eol.join(lines) + eol, encoding="utf-8", errors="surrogateescape")
        os.replace(tmp, path)
        if applied or created:
            new_state[reg_file] = {"entries": applied, "created": created}
    if new_state:
        state_path.write_text(json.dumps(new_state, indent=2, sort_keys=True) + "\n",
                              encoding="utf-8")
    else:
        state_path.unlink(missing_ok=True)


def apply_reg_value(lines, section, name, value_text, create):
    """Set one value; returns (state_entry, changed, created) or None."""
    found = find_section(lines, section)
    created = False
    if found is None:
        if not create:
            return None
        if lines and lines[-1] != "":
            lines.append("")
        lines.append(f"[{section}]")
        found = find_section(lines, section)
        created = True
    start, end = found
    prefix = f'"{name}"='
    new_line = f"{prefix}{value_text}"
    for i in range(start + 1, end):
        if lines[i].startswith(prefix):
            old_line = lines[i]
            if old_line != new_line:
                lines[i] = new_line
                return ({"section": section, "name": name, "had": True, "line": old_line},
                        True, created)
            return ({"section": section, "name": name, "had": True, "line": old_line},
                    False, created)
    insert = start + 1
    if insert < end and lines[insert].startswith("#time"):
        insert += 1
    lines.insert(insert, new_line)
    return ({"section": section, "name": name, "had": False, "line": None}, True, created)


def revert_reg_value(lines, entry):
    """Undo one managed value. Returns True when the file changed."""
    found = find_section(lines, entry["section"])
    if found is None:
        return False
    start, end = found
    prefix = f"\"{entry['name']}\"="
    for i in range(start + 1, end):
        if not lines[i].startswith(prefix):
            continue
        if entry["had"]:
            if lines[i] != entry["line"]:
                lines[i] = entry["line"]
                return True
            return False
        del lines[i]
        return True
    if entry["had"]:
        # our value vanished on its own; put the original back
        insert = start + 1
        if insert < end and lines[insert].startswith("#time"):
            insert += 1
        lines.insert(insert, entry["line"])
        return True
    return False


def drop_empty_section(lines, section):
    """Remove a section we created once it holds no values anymore."""
    found = find_section(lines, section)
    if found is None:
        return False
    start, end = found
    body = [line for line in lines[start + 1:end]
            if line and not line.startswith("#time")]
    if body:
        return False
    del_start = start
    if del_start > 0 and lines[del_start - 1] == "":
        del_start -= 1
    del lines[del_start:end]
    return True


def main():
    args = sys.argv[1:]
    if not args:
        raise SystemExit("usage: nebel-game-launch COMMAND [ARGS...]")

    # Proton-CachyOS enables its shader compiler HUD unless DXVK_HUD is already
    # set. Keep Nebel's default clean while preserving an explicit user HUD.
    os.environ.setdefault("DXVK_HUD", "none")

    game_id = appid()
    settings = {}
    try:
        contract = load_fex_contract()
        settings = merged_settings(load_tweaks(contract["defaults"]), game_id)
        apply_fex(settings, game_id, contract["profiles"], os.environ)
    except Exception as exc:
        print(f"nebel-game-launch: failed to apply settings: {exc}", file=sys.stderr)

    try:
        apply_cpu_affinity(settings)
    except OSError as exc:
        print(f"nebel-game-launch: CPU affinity skipped: {exc}", file=sys.stderr)

    try:
        inject_x86_protocol_libs()
    except Exception as exc:
        print(f"nebel-game-launch: protocol-lib inject skipped: {exc}", file=sys.stderr)

    try:
        repair_wedged_controller()
    except Exception as exc:
        print(f"nebel-game-launch: controller repair skipped: {exc}", file=sys.stderr)

    wined3d = use_wined3d(settings)
    try:
        apply_renderer(settings, os.environ)
    except Exception as exc:
        print(f"nebel-game-launch: renderer setting skipped: {exc}", file=sys.stderr)

    try:
        apply_gpu_spoof(settings, os.environ, wined3d)
    except Exception as exc:
        print(f"nebel-game-launch: GPU spoof skipped: {exc}", file=sys.stderr)

    pfx = pfx_dir()
    if pfx is not None:
        try:
            sync_registry(pfx, settings, wined3d)
        except Exception as exc:
            print(f"nebel-game-launch: registry sync skipped: {exc}", file=sys.stderr)
        if not wined3d:
            # WineD3D replaces the whole D3D stack, so dll overrides are moot.
            try:
                apply_dxvk_override(pfx, settings)
            except Exception as exc:
                print(f"nebel-game-launch: graphics override skipped: {exc}", file=sys.stderr)

    try:
        apply_memory_limit(settings)
    except (OSError, ValueError) as exc:
        print(f"nebel-game-launch: memory limit skipped: {exc}", file=sys.stderr)

    try:
        os.execv(args[0], args)
    except OSError as exc:
        raise SystemExit(f"nebel-game-launch: failed to exec game: {exc}")


if __name__ == "__main__":
    main()
